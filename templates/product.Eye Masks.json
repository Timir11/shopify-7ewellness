        "tab_TPkht9": {
          "type": "tab",
          "settings": {
            "title": "Who is this for?",
            "content": "<p>Ideal for individuals seeking to address signs of aging, such as fine lines and wrinkles around the eyes and forehead. It's suitable for both beginners and those experienced with microcurrent therapy. Please note, individuals with a history of skin reactions to adhesives should exercise caution.<\/p>",
            "page": ""
