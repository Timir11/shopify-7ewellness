QR"],"settings":{"title":"AS SEEN IN","logo_opacity":100,"alt":false}},"new_edition_tabs_fG74wP":{"type":"new-edition-tabs","blocks":{"collection_tab_phzBDr":{"type":"collection_tab","settings":{"collection":"at-home-kits","button_text":"View All","button_url":""}},"collection_tab_piFMyM":{"type":"collection_tab","settings":{"collection":"professionals-kits","button_text":"View All","button_url":""}},"collection_tab_QUNT3C":{"type":"collection_tab","disabled":true,"settings":{"collection":"professionals-kits","button_text":"Full Products","button_url":""}}},"block_order":["collection_tab_phzBDr","collection_tab_piFMyM","collection_tab_QUNT3C"],"name":"New Editon Tabs Section","settings":{"section_heading":"New Edition Kits","shop_all_collection":""}},"review_slideshow_ajac8F":{"type":"review-slideshow","blocks":{"image_wjykwT":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/review-pic-3.jpg","text":"<p>I love this and use it on trips all the time; I’ll just run it back and forth on my face while I doom scroll on Instagram. And it really has made a difference in the jowl area.<\/p>","customer_name":"- Mindy Kaling","sub_text":"American Actress, Screenwriter, and Producer"}},"image_fFwRAk":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/review-pic-1.png","text":"<p>Despite having over 25 years of professional experience as a skin practitioner, I use MyoLift QT myself and never travel without it. The device is genius—compact, lightweight, and incredibly easy to use.<\/p>","customer_name":"- Dr. Meder","sub_text":""}},"image_aYFxjE":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Review-pic-4.png","text":"<p>The Microcurrent, especially Myo lift is so exciting because the results really are incredible. And I tell every client, no matter if you're 25or 85, you will see a difference in your skin. And that difference will be cumulative. Microcurrent machine, it is an investment that you're making into your business.<\/p>","customer_name":"- Joanna Vargas","sub_text":""}},"image_LeCFC3":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Review-pic-5.png","text":"<p>This beauty tool is a game changer for firming and toning your skin. Just glide it across your face in upward motions for a few minutes a day to stimulate and contour. It’s like a mini face workout that leaves you glowing and lifted.<\/p>","customer_name":"- Sarah Akram","sub_text":""}}},"block_order":["image_wjykwT","image_fFwRAk","image_aYFxjE","image_LeCFC3"],"settings":{"custom_class":"","title":"What Experts Say"}},"rich_text_3AP6iN":{"type":"rich-text","blocks":{"heading_66ccxm":{"type":"heading","settings":{"title":"As Seen In"}},"text_UXJwxL":{"type":"text","settings":{"enlarge_text":false,"text":"<p> <\/p>"}}},"block_order":["heading_66ccxm","text_UXJwxL"],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"custom_class":"","align_text":"center","narrow_column":true,"alt":false}},"novel_dynamic_tabs_Wz3ACC":{"type":"novel-dynamic-tabs","blocks":{"novel_tab_ePRxqp":{"type":"novel_tab","settings":{"tab_name":"At-Home Devices","journey_id":"6901ff4078f441000852d765"}},"novel_tab_mPG7Bh":{"type":"novel_tab","settings":{"tab_name":"Professional devices","journey_id":"68f693c68e718f00027a7597"}}},"block_order":["novel_tab_ePRxqp","novel_tab_mPG7Bh"],"disabled":true,"name":"Novel Dynamic Tabs","settings":{}},"featured_product_HmL4wM":{"type":"featured-product","blocks":{"price_Khji7P":{"type":"price","settings":{}},"description_XbjcEb":{"type":"description","settings":{"is_tab":false}},"variant_picker_LqkqtA":{"type":"variant_picker","settings":{"variant_labels":true,"picker_type":"button","product_dynamic_variants_enable":true,"color_swatches":false}},"buy_buttons_diVkTP":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"surface_pickup_enable":true,"show_gift_card_recipient":false}}},"block_order":["price_Khji7P","description_XbjcEb","variant_picker_LqkqtA","buy_buttons_diVkTP"],"settings":{"custom_class":"featured-product-section","featured_product":"at-home-microcurrent-devices-myolift-qt-plus-facial-toning","product_image_size":"small","product_image_type":"slider","product_zoom_enable":false,"enable_video_looping":true,"product_video_style":"muted","sku_enable":false,"section_title":"<h3>Tried<strong> + Tested<\/strong><\/h3>","section_img":"shopify:\/\/shop_images\/Group_1000007693.svg","section_sub_text":"91%","section_text":"<p>Noticed immediate skin lift after doing the treatment<br\/><br\/><\/p>","section_content":"<p>*Based on 16-week consumer study<br\/><br\/><\/p>"}},"text_with_icons_94L79W":{"type":"text-with-icons","blocks":{"text_block_dx8dhP":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"91%","text":"<p>Noticed, immediate skin lift after doing the treatment<\/p>"}},"text_block_6g9wdN":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"85%","text":"<p>Noticed, forehead fine lines reduced<\/p>"}},"text_block_P7mNgD":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"91%","text":"<p>Noticed, Crow’s feet appeared reduced<\/p>"}},"text_block_CjwggA":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"100%","text":"<p>Felt good after a MyoLift treatment<\/p>"}}},"block_order":["text_block_dx8dhP","text_block_6g9wdN","text_block_P7mNgD","text_block_CjwggA"],"settings":{"custom_class":"counter-section","title":"","align_text":"center","desktop_columns_per_row":4,"icon_color":"#000000","button_label":"","button_link":"","alt":false}},"text_and_image_ncJdT6":{"type":"text-and-image","blocks":{"custom_kiGUad":{"type":"custom","settings":{"code":"<div class=\"benefit_wrapper\">\n    <div class=\"benefit\">\n        <div class=\"icon\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Lifted_skin.svg?v=1738128023\">\n        <\/div>\n        <span>Lifted skin<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Improves_skins_texture.svg?v=1738128023\"><\/div>\n        <span>Improves skin texture<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Reduce_fine_lines_wrinkles.svg?v=1738128023\">\n        <\/div>\n        <span>Reduce fine lines & wrinkles<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Facial_contouring.svg?v=1738128023\"><\/div>\n        <span>Facial contouring<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Prevent_line_wrinkles.svg?v=1738128023\"><\/div>\n        <span>Prevent lines & wrinkles<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Reduce_Skin_redness.svg?v=1738128023\"><\/div>\n        <span>Reduce skin redness<\/span>\n    <\/div>\n<\/div>"}},"faq_thLPmp":{"type":"faq","settings":{"title":"How Does Microcurrent Work?","text":"<p>Microcurrent uses low-level electrical currents to stimulate facial muscles, mimicking the body’s natural bioelectrical signals. This process enhances ATP (adenosine triphosphate) production, which fuels cellular energy, leading to improved muscle tone, collagen synthesis, and skin hydration.<\/p>"}},"faq_NJaJQg":{"type":"faq","settings":{"title":"Is Microcurrent Safe?","text":"<p>Yes, microcurrent therapy is a clinically tested and FDA-cleared treatment that is completely non-invasive and painless. It works in harmony with the body’s natural electrical currents, making it a safe option for most skin types.<\/p>"}},"faq_fEXL6G":{"type":"faq","settings":{"title":"What Makes MyoLift Unique?","text":"<p>MyoLift™ stands out due to its:<\/p><ul><li><strong>True Microcurrent Technology<\/strong> – Ensures precise delivery of microcurrent for optimal skin rejuvenation.<\/li><li><strong>Customizable Intensity<\/strong> – Adjustable settings for different skin sensitivities and treatment areas.<\/li><li><strong>Dual Waveform Technology<\/strong> – Provides lifting and toning benefits while enhancing ATP production.<\/li><\/ul>"}},"faq_4AH3HY":{"type":"faq","settings":{"title":"Can This Be Used With Other Devices Or Facial Treatments?","text":"<p>Yes, MyoLift™ can be safely combined with other skincare treatments, including LED therapy, serums, and facials, to enhance results. However, it’s recommended to use water-based conductive gels for the best microcurrent conductivity.<\/p>"}},"faq_AKATFw":{"type":"faq","settings":{"title":"How Many Treatments Are Needed?","text":"<p>For optimal results, a series of <strong>6-12 treatments<\/strong> is typically recommended, followed by <strong>maintenance sessions<\/strong> to sustain the lifted and toned appearance. The frequency depends on individual skin concerns and goals.<\/p>"}},"faq_Xhgpcy":{"type":"faq","settings":{"title":"When Can I See Results?","text":"<p>Results can be noticeable <strong>immediately after a single session<\/strong>, with improvements in skin firmness, lift, and hydration. However, long-term results become more visible with consistent use over <strong>4-6 weeks<\/strong>.<\/p>"}}},"block_order":["custom_kiGUad","faq_thLPmp","faq_NJaJQg","faq_fEXL6G","faq_4AH3HY","faq_AKATFw","faq_Xhgpcy"],"settings":{"custom_class":"award-winning-section","image":"shopify:\/\/shop_images\/Group_1000007649.png","video_url":"","image_mask":"none","image2_mask":"none","subtitle":"","title":"Award Winning Microcurrent Technology","text":"<p>Experience the power of professional-grade microcurrent technology with MyoLift™, designed to deliver safe, non-invasive facial rejuvenation. Recognized for its advanced precision and effectiveness, MyoLift™ helps tone, lift, and refresh your skin for a youthful appearance.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"right","alt":false,"top_padding":true,"bottom_padding":true,"lazyload_images":true}}},"order":["main","blocks_JgXqjE","slideshow_xE6JzL","text_columns_VXrLYP","custom_tabs_section_M3PELF","logo_list_LXnfAj","new_edition_tabs_fG74wP","review_slideshow_ajac8F","rich_text_3AP6iN","novel_dynamic_tabs_Wz3ACC","featured_product_HmL4wM","text_with_icons_94L79W","text_and_image_ncJdT6"]}