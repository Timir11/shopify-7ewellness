hop_images\/Group_1000007753.png","video_url":"","image_mask":"none","image2_mask":"none","subtitle":"","title":"The Science of Microcurrent Technology","text":"<p>From the start, 7E Wellness has been driven by women who understand the needs of real people. As a leader in non-invasive skincare, our commitment to delivering exceptional results has earned us accolades and recognition within the beauty and wellness industries. Every product and solution we create reflects our mission to empower you with confidence and radiance.<br\/><br\/><\/p>","button_label":"","button_link":"shopify:\/\/pages\/contact-us","button_style":"primary","align_text":"left","image_width":"50","layout":"left","alt":false,"top_padding":true,"bottom_padding":true,"lazyload_images":true}},"mission_vision_MhXQt7":{"type":"mission-vision","blocks":{"block_icHjVV":{"type":"block","settings":{"number":"15+","txt":"Years of Expertise"}},"block_9tmHGV":{"type":"block","settings":{"number":"10+","txt":"Country worldwide"}},"block_nQzLzG":{"type":"block","settings":{"number":"8+","txt":"Microcurrent devices"}}},"block_order":["block_icHjVV","block_9tmHGV","block_nQzLzG"],"custom_css":["@media (max-width: 767px) {p {font-size: 16px; line-height: 24px; } .about-experience {display: block; } .about-experience-block .experience-year-number {font-size: 44px; } .about-experience-block h5 {font-size: 14px; }}"],"settings":{"bgcolor":"#fefbff","border":true,"bordercolor":"#000000","btn_txt":"Mission & Vision","description":"<p>7e Wellness’ purpose is to be the most trusted provider of non-invasive microcurrent technology for mind, body, and skin wellness for home users, beauty professionals, and educators. We aim to empower people to look, feel, and be their most confident selves with each treatment while fostering a supportive community that promotes holistic well-being and creates a meaningful impact on people’s lives.<\/p>","show_experience":true}},"176175731397112710":{"type":"_blocks","settings":{}},"1761826236de1ce076":{"type":"apps","settings":{"full_width":false,"space_around":true}},"novel_dynamic_tabs_HRae8d":{"type":"novel-dynamic-tabs","blocks":{"novel_tab_RniQfM":{"type":"novel_tab","settings":{"tab_name":"At-Home Devices","journey_id":"6901ff4078f441000852d765"}},"novel_tab_wcPTeB":{"type":"novel_tab","settings":{"tab_name":"Professional devices","journey_id":"68f693c68e718f00027a7597"}}},"block_order":["novel_tab_RniQfM","novel_tab_wcPTeB"],"name":"Novel Dynamic Tabs","settings":{}},"advanced_content_tQCMQY":{"type":"advanced-content","blocks":{"liquid_eW37zW":{"type":"liquid","settings":{"code":"<left><h2>The breakthrough that\u2028launched the brand 15 years ago.<\/h2><\/left>","width":"50%","alignment":"top-middle"}},"liquid_GxbFfY":{"type":"liquid","settings":{"code":"<p>The journey to making better things in a better way is a long one, and we’re just getting started. Here are a few of our proudest moments so far:<\/p>","width":"33%","alignment":"top-middle"}}},"block_order":["liquid_eW37zW","liquid_GxbFfY"],"custom_css":[".index-section {padding: 80px 0px;}",".custom-content {border: none;}","@media (max-width: 767px) {.index-section {padding: 50px 0px !important; }}"],"settings":{"full_width":true,"space_around":true,"alt":false,"custom_class":"","lazyload_images":true}},"timeline_slider_xkG3zq":{"type":"timeline-slider","blocks":{"text_4gjif6":{"type":"text","settings":{"year":"2012","img":"shopify:\/\/shop_images\/2012.png","txt":"<p>7e Wellness was founded as <strong>7e Fit Spa<\/strong>, a wellness spa focused on mind, body, and skin rejuvenation using advanced bio-electrical stimulation technologies.<\/p>"}},"text_FLPiXT":{"type":"text","settings":{"year":"2015","img":"shopify:\/\/shop_images\/2015.png","txt":"<p>The <strong>MyoLift<\/strong> brand was born with the launch of the <strong>MyoLift Mini<\/strong>—the most powerful microcurrent technology available to skincare professionals at the time.<\/p>"}},"text_pR3E6w":{"type":"text","settings":{"year":"2018","img":"shopify:\/\/shop_images\/2018.png","txt":"<p>The <strong>MyoLift MD <\/strong>was launched and introduced into all the Exhale Spas and Beauty schools, while <strong>MyoLift Mini<\/strong> was adapted for home use, bringing professional-grade microcurrent technology into the hands of consumers around the world.<\/p>"}},"text_WjNEk4":{"type":"text","settings":{"year":"2019","img":"shopify:\/\/shop_images\/2019.png","txt":"<p>The <strong>Torc Body<\/strong> technology was private labeled to a public company for distribution into MedSpas<\/p>"}},"text_xeXz8H":{"type":"text","settings":{"year":"2020","img":"shopify:\/\/shop_images\/2020.png","txt":"<p>The revolutionary <strong>MyoLift QT V1.0 <\/strong>was introduced—the first smart app-connected microcurrent device, featuring AI-powered skin analysis, personalized treatments, with one-on-one virtual consultations.<\/p>"}},"text_A9DXBG":{"type":"text","settings":{"year":"2022","img":"shopify:\/\/shop_images\/2022.png","txt":"<p>The Myolift Triwave was introduced for skin enthusiasts who wanted to take their skincare journey to the next level. <\/p>"}}},"block_order":["text_4gjif6","text_FLPiXT","text_pR3E6w","text_WjNEk4","text_xeXz8H","text_A9DXBG"],"custom_css":["@media screen and (max-width: 480px) {.rte {padding-left: 15px !important; }"],"settings":{"altColor":false}},"text_and_image_yMdx4x":{"type":"text-and-image","blocks":{"faq_tzGkit":{"type":"faq","settings":{"title":"People","text":"<p>Empowering individuals to look and feel their best with every treatment.<\/p><ul><li>Real Customer Testimonials & Transformations<\/li><li>Holistic & Non-Invasive Benefits for long-term well-being<\/li><li>Educational Support & Emotional Well-being<\/li><\/ul>"}},"faq_JD9MT6":{"type":"faq","settings":{"title":"Innovation","text":"<p>Leading in Microcurrent Technology<\/p><ul><li>Mind: Reduce stress, promote relaxation, and restore balance (MyoCalmes)<\/li><li>Body: Sculpt, tone, and strengthen muscles for