        "66232a31-cb5f-4a67-97cf-d0377bb2fac6": {
          "type": "tab",
          "settings": {
            "title": "How To Use",
            "content": "<ol><li><strong>Preparation<\/strong>: Cleanse the skin thoroughly to remove any oils or residues.<br\/><\/li><li><strong>Application<\/strong>: Peel the electrode from its backing and apply it to the desired area on the face or neck<br\/><\/li><li><strong>Connection<\/strong>: Attach the lead wire from your MyoLift™ device to the electrode.<br\/><\/li><li><strong>Treatment<\/strong>: Turn on the device and proceed with your microcurrent session as directed.<br\/><\/li><li><strong>After Use<\/strong>: Carefully remove the electrode and place it back on its protective backing for future use.<\/li><\/ol>",
            "page": ""
          }
        },
        "tab": {
          "type": "tab",
          "settings": {
            "title": "Benefits",
            "content": "<ul><li><strong>Hands-Free Treatment<\/strong>: Allows for microcurrent therapy without the need to hold probes, enabling multitasking during sessions.<br\/><\/li><li><strong>Targeted Application<\/strong>: Ideal for focusing on specific areas such as the forehead, cheeks, or neck.<br\/><\/li><li><strong>Reusable<\/strong>: With proper care, electrodes can be reused multiple times, offering cost-effectiveness.<br\/><\/li><li><strong>Enhanced Results<\/strong>: Provides consistent contact with the skin, ensuring effective delivery of microcurrent.<\/li><\/ul>",
