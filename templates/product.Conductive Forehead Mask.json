        "tab_TPkht9": {
          "type": "tab",
          "settings": {
            "title": "What is this for?",
            "content": "<p>Ideal for individuals seeking to address signs of aging, such as fine lines and wrinkles on the forehead. Suitable for both beginners and those experienced with microcurrent therapy. Not recommended for individuals who have a history of skin reactions to adhesives.<\/p>",
