            "image_mask": "none",
            "image_width": 60,
            "title": "",
            "text": "<h3><strong>Affects the epidermis and dermal layers of the skin.<\/strong><\/h3>",
            "button_label": "",
            "button_link": ""
          }
        },
        "template--14979966533686__cef73ac3-1b1f-4f7f-8e08-18b08402df9d-text_block-2": {
          "type": "text_block",
          "settings": {
