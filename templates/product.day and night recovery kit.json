            "image_mask": "none",
            "image_width": 60,
            "title": "",
            "text": "<h3><strong>Assists in the formation of<br\/>elastin in collagen, deep within the skin tissue.<\/strong><\/h3>",
            "button_label": "",
            "button_link": ""
          }
        },
        "e00eb12c-b540-4081-8d05-d1e0e279dcec": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify:\/\/shop_images\/day_and_night_1.png",
            "image_mask": "none",
            "image_width": 60,
            "title": "",
            "text": "<h3>Gives firmer skin and reduces the appearance of wrinkles.<\/h3>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "template--14979966533686__cef73ac3-1b1f-4f7f-8e08-18b08402df9d-text_block-1",
