oLift QT myself and never travel without it. The device is genius—compact, lightweight, and incredibly easy to use.<\/p>","customer_name":"- Dr. Meder","sub_text":""}},"image_qqLB4a":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Review-pic-4.png","text":"<p>The Microcurrent, especially Myo lift is so exciting because the results really are incredible. And I tell every client, no matter if you're 25or 85, you will see a difference in your skin. And that difference will be cumulative. Microcurrent machine, it is an investment that you're making into your business.<\/p>","customer_name":"- Joanna Vargas","sub_text":""}},"image_zQHrXj":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Review-pic-5.png","text":"<p>This beauty tool is a game changer for firming and toning your skin. Just glide it across your face in upward motions for a few minutes a day to stimulate and contour. It’s like a mini face workout that leaves you glowing and lifted.<\/p>","customer_name":"- Sarah Akram","sub_text":""}}},"block_order":["image_73AkhR","image_PNTNEe","image_qqLB4a","image_zQHrXj"],"settings":{"custom_class":"","title":"What Experts Say"}},"rich_text_jWAL9D":{"type":"rich-text","blocks":{"heading_LW7GcL":{"type":"heading","settings":{"title":"As Seen In"}},"text_ff3PWH":{"type":"text","settings":{"enlarge_text":false,"text":"<p> <\/p>"}}},"block_order":["heading_LW7GcL","text_ff3PWH"],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"custom_class":"","align_text":"center","narrow_column":true,"alt":false}},"novel_dynamic_tabs_3TCXU7":{"type":"novel-dynamic-tabs","blocks":{"novel_tab_EinDMM":{"type":"novel_tab","settings":{"tab_name":"At-Home Devices","journey_id":"6901ff4078f441000852d765"}},"novel_tab_8dKYrz":{"type":"novel_tab","settings":{"tab_name":"Professional devices","journey_id":"68f693c68e718f00027a7597"}}},"block_order":["novel_tab_EinDMM","novel_tab_8dKYrz"],"name":"Novel Dynamic Tabs","settings":{}},"featured_product_3zCbJN":{"type":"featured-product","blocks":{"price_Kf9RMx":{"type":"price","settings":{}},"description_4M4A9f":{"type":"description","settings":{"is_tab":false}},"variant_picker_3kgba7":{"type":"variant_picker","settings":{"variant_labels":true,"picker_type":"button","product_dynamic_variants_enable":true,"color_swatches":false}},"buy_buttons_JFARPf":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"surface_pickup_enable":true,"show_gift_card_recipient":false}}},"block_order":["price_Kf9RMx","description_4M4A9f","variant_picker_3kgba7","buy_buttons_JFARPf"],"settings":{"custom_class":"featured-product-section","featured_product":"at-home-microcurrent-devices-myolift-qt-plus-facial-toning","product_image_size":"small","product_image_type":"slider","product_zoom_enable":false,"enable_video_looping":true,"product_video_style":"muted","sku_enable":false,"section_title":"<h3>Tried<strong> + Tested<\/strong><\/h3>","section_img":"shopify:\/\/shop_images\/Group_1000007693.svg","section_sub_text":"91%","section_text":"<p>Noticed immediate skin lift after doing the treatment<br\/><br\/><\/p>","section_content":"<p>*Based on 16-week consumer study<br\/><br\/><\/p>"}},"text_with_icons_br3f6B":{"type":"text-with-icons","blocks":{"text_block_nj8jfE":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"91%","text":"<p>Noticed, immediate skin lift after doing the treatment<\/p>"}},"text_block_XPwNAF":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"85%","text":"<p>Noticed, forehead fine lines reduced<\/p>"}},"text_block_HTdQUR":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"91%","text":"<p>Noticed, Crow’s feet appeared reduced<\/p>"}},"text_block_FUtLqa":{"type":"text_block","settings":{"hide_icon":true,"icon":"chat","title":"100%","text":"<p>Felt good after a MyoLift treatment<\/p>"}}},"block_order":["text_block_nj8jfE","text_block_XPwNAF","text_block_HTdQUR","text_block_FUtLqa"],"settings":{"custom_class":"counter-section","title":"","align_text":"center","desktop_columns_per_row":4,"icon_color":"#000000","button_label":"","button_link":"","alt":false}},"text_and_image_hprg6t":{"type":"text-and-image","blocks":{"custom_CGNjtn":{"type":"custom","settings":{"code":"<div class=\"benefit_wrapper\">\n    <div class=\"benefit\">\n        <div class=\"icon\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Lifted_skin.svg?v=1738128023\">\n        <\/div>\n        <span>Lifted skin<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Improves_skins_texture.svg?v=1738128023\"><\/div>\n        <span>Improves skin texture<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Reduce_fine_lines_wrinkles.svg?v=1738128023\">\n        <\/div>\n        <span>Reduce fine lines & wrinkles<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Facial_contouring.svg?v=1738128023\"><\/div>\n        <span>Facial contouring<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Prevent_line_wrinkles.svg?v=1738128023\"><\/div>\n        <span>Prevent lines & wrinkles<\/span>\n    <\/div>\n    <div class=\"benefit\">\n        <div class=\"icon\"><img\n                src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/2745\/9950\/files\/Reduce_Skin_redness.svg?v=1738128023\"><\/div>\n        <span>Reduce skin redness<\/span>\n    <\/div>\n<\/div>"}},"faq_zfkdqB":{"type":"faq","settings":{"title":"How Does Microcurrent Work?","text":"<p>Microcurrent uses low-level electrical currents to stimulate facial muscles, mimicking the body’s natural bioelectrical signals. This process enhances ATP (adenosine triphosphate) production, which fuels cellular energy, leading to improved muscle tone, collagen synthesis, and skin hydration.<\/p>"}},"faq_yH9yTY":{"type":"faq","settings":{"title":"Is Microcurrent Safe?","text":"<p>Yes, microcurrent therapy is a clinically tested and FDA-cleared treatment that is completely non-invasive and painless. It works in harmony with the body’s natural electrical currents, making it a safe option for most skin types.<\/p>"}},"faq_xarMmF":{"type":"faq","settings":{"title":"What Makes MyoLift Unique?","text":"<p>MyoLift™ stands out due to its:<\/p><ul><li><strong>True Microcurrent Technology<\/strong> – Ensures precise delivery of microcurrent for optimal skin rejuvenation.<\/li><li><strong>Customizable Intensity<\/strong> – Adjustable settings for different skin sensitivities and treatment areas.<\/li><li><strong>Dual Waveform Technology<\/strong> – Provides lifting and toning benefits while enhancing ATP production.<\/li><\/ul>"}},"faq_rABYbf":{"type":"faq","settings":{"title":"Can This Be Used With Other Devices Or Facial Treatments?","text":"<p>Yes, MyoLift™ can be safely combined with other skincare treatments, including LED therapy, serums, and facials, to enhance results. However, it’s recommended to use water-based conductive gels for the best microcurrent conductivity.<\/p>"}},"faq_eMc9WA":{"type":"faq","settings":{"title":"How Many Treatments Are Needed?","text":"<p>For optimal results, a series of <strong>6-12 treatments<\/strong> is typically recommended, followed by <strong>maintenance sessions<\/strong> to sustain the lifted and toned appearance. The frequency depends on individual skin concerns and goals.<\/p>"}},"faq_VLfPTd":{"type":"faq","settings":{"title":"When Can I See Results?","text":"<p>Results can be noticeable <strong>immediately after a single session<\/strong>, with improvements in skin firmness, lift, and hydration. However, long-term results become more visible with consistent use over <strong>4-6 weeks<\/strong>.<\/p>"}}},"block_order":["custom_CGNjtn","faq_zfkdqB","faq_yH9yTY","faq_xarMmF","faq_rABYbf","faq_eMc9WA","faq_VLfPTd"],"settings":{"custom_class":"award-winning-section","image":"shopify:\/\/shop_images\/Group_1000007649.png","video_url":"","image_mask":"none","image2_mask":"none","subtitle":"","title":"Award Winning Microcurrent Technology","text":"<p>Experience the power of professional-grade microcurrent technology with MyoLift™, designed to deliver safe, non-invasive facial rejuvenation. Recognized for its advanced precision and effectiveness, MyoLift™ helps tone, lift, and refresh your skin for a youthful appearance.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"right","alt":false,"top_padding":true,"bottom_padding":true,"lazyload_images":true}},"text_and_image_NeYRxy":{"type":"text-and-image","disabled":true,"settings":{"custom_class":"founder-section","image":"shopify:\/\/shop_images\/Group_1000007578.png","video_url":"https:\/\/www.youtube.com\/watch?v=qFKn1ogyMy0&t=164s","image_mask":"landscape","image2_mask":"none","subtitle":"","title":"Message from our founder","text":"<p>I created MyoLift™ to empower beauty professionals by focusing on a non invasive and natural approach to skincare. My unique holistic approach to wellness is centered around seven elements that when combined, help women naturally enhance their beauty internally and externally.<\/p><p>I provide hands-on training for professionals not only to educate and enhance their creativity, but also to understand their needs & receive feedback to constantly advance MyoLift™ machines. This approach allows us to continue designing the best microcurrent machines on the market.<\/p>","button_label":"Learn More","button_link":"shopify:\/\/pages\/about-us","button_style":"primary","align_text":"left","image_width":"66","layout":"left","alt":false,"top_padding":true,"bottom_padding":true,"lazyload_images":true}},"pagefly_section_ca4XgG":{"type":"pagefly-section","disabled":true,"name":"PageFly Section","settings":{"section_id":"pf-1024abf8"}},"1779365918823cba5a":{"type":"_blocks","settings":{}},"1779366203bbeaeb96":{"type":"_blocks","blocks":{"ai_gen_block_5ca0bcc_P4KAhj":{"type":"ai_gen_block_5ca0bcc","disabled":true,"settings":{"columns_desktop":3,"columns_mobile":"2","aspect_ratio":"square","gap":16,"desktop_width_percent":100,"border_radius":0,"hover_scale":2,"placeholder_bg":"#f4f4f4","show_captions":true,"caption_size":14,"caption_color":"#ffffff","overlay_opacity":0.7,"enable_lightbox":true,"image_1":"shopify:\/\/shop_images\/2.webp","caption_1":"","image_2":"shopify:\/\/shop_images\/5.webp","caption_2":"","image_3":"shopify:\/\/shop_images\/triple-crown-classic-117967.webp","caption_3":"","image_4":"shopify:\/\/shop_images\/1.webp","caption_4":"","image_5":"shopify:\/\/shop_images\/jvfacial.png","caption_5":"","image_6":"shopify:\/\/shop_images\/3.webp","caption_6":"","image_7":"shopify:\/\/shop_images\/triple-crown-royale-221831_1.webp","caption_7":"","image_8":"shopify:\/\/shop_images\/triple-crown-royale-885305_1.webp","caption_8":"","image_9":"shopify:\/\/shop_images\/triple-crown-royale-335797_1.webp","caption_9":"","caption_10":"","caption_11":"","caption_12":""},"blocks":{}}},"block_order":["ai_gen_block_5ca0bcc_P4KAhj"],"settings":{}}},"order":["1762179661bc0efb9a","slideshow_N7eNHm","text_columns_8nxhVL","custom_tabs_section_VJPwyx","real_customer_cE3VVx","logo_list_gG8Ucz","new_edition_tabs_JcXKNr","review_slideshow_gmVyYb","rich_text_jWAL9D","novel_dynamic_tabs_3TCXU7","featured_product_3zCbJN","text_with_icons_br3f6B","text_and_image_hprg6t","text_and_image_NeYRxy","pagefly_section_ca4XgG","1779365918823cba5a","1779366203bbeaeb96"]}