        "how_to_use_4AraaD": {
          "type": "how-to-use",
          "settings": {
            "tab_heading": "How To Use",
            "heading": "How it works",
            "section_content": "<p><strong>The RePlenish Spritzer is your go-to hydration support during microcurrent treatments. It rehydrates conductive gels mid-session and keeps your skin supple, comfortable, and well-prepped for optimal results—without any sticky residue.</strong></p>",
            "image": "shopify://shop_images/desktop_8_2OZ_REPLENISH_SPRITZER.png",
            "mobile_image": "shopify://shop_images/mobile_8_2OZ_REPLENISH_SPRITZER.png",
            "link": "",
            "width": "100%",
            "alignment": "center"
          }
        },
        "image_banner_BG6ePX": {
          "type": "image-banner",
          "settings": {
            "tab_heading": "Benefits",
            "heading": "What Makes Our Gel So Special?",
            "image_banner": "shopify://shop_images/1_96_2.png",
            "mobile_image_banner": "shopify://shop_images/1_96_3.png",
            "image_content": "<p><strong>Formulated with hyaluronic acid, chamomile, and lavender, this lightweight spray delivers calming, moisture-rich benefits to all skin types. Use it before, during, or after your microcurrent routine for a refreshed, balanced glow.</strong></p>"
          }
        },
        "ingredients_i6aWGd": {
          "type": "ingredients",
          "settings": {
            "tab_heading": "Ingredients",
            "heading": "Our key ingredients",
