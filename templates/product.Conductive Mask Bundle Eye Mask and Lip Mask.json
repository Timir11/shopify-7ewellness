        },
        "tab_QLEFEc": {
          "type": "tab",
          "settings": {
            "title": "Product Features",
            "content": "<ul><li><strong>Hands-Free Design<\/strong>: Allows for multitasking during treatment sessions.<\/li><li><strong>Reusable<\/strong>: Each mask can be used for 10–12 treatments.<\/li><li><strong>No Conductive Gel Required<\/strong>: Simplifies the treatment process.<\/li><li><strong>Compatible with MyoLift™ Devices<\/strong>: Designed to work seamlessly with MyoLift™ QT Plus and MyoLift™ Mini.<\/li><\/ul><p><strong>FDA Approved<\/strong>: Ensures safety and efficacy.<\/p>",
            "page": ""
          }
        },
