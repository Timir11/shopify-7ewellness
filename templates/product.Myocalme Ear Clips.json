        "66232a31-cb5f-4a67-97cf-d0377bb2fac6": {
          "type": "tab",
          "settings": {
            "title": "How To Use",
            "content": "<ol><li><strong>Preparation<\/strong>: Ensure the MyoCalme device is turned off.<br\/><\/li><li><strong>Application of Conductive Gel<\/strong>: Apply a small amount of conductive gel to the pads of the ear clips.<br\/><\/li><li><strong>Attachment<\/strong>: Gently attach the ear clips to your earlobes, ensuring a secure and comfortable fit.<br\/><\/li><li><strong>Connection<\/strong>: Plug the ear clips into the MyoCalme device using the appropriate cable.<br\/><\/li><\/ol><p><strong>Operation<\/strong>: Turn on the MyoCalme device and select the desired settings as per the user manual.<\/p>",
            "page": ""
          }
        },
        "tab": {
          "type": "tab",
