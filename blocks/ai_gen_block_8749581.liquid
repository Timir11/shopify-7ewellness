{% doc %}
  @prompt
    gallery
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-gallery-container-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.gap }}px;
    {% if block.settings.layout == 'grid' %}
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    {% elsif block.settings.layout == 'masonry' %}
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      grid-auto-rows: {{ block.settings.masonry_row_height }}px;
    {% elsif block.settings.layout == 'horizontal' %}
      grid-auto-flow: column;
      grid-auto-columns: {{ block.settings.horizontal_image_width }}%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    {% endif %}
  }

  .ai-gallery-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.layout == 'horizontal' %}
      scroll-snap-align: start;
    {% endif %}
  }

  {% if block.settings.layout == 'masonry' %}
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(3n+1) {
      grid-row: span 2;
    }
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(3n+2) {
      grid-row: span 3;
    }
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(3n+3) {
      grid-row: span 2;
    }
  {% endif %}

  .ai-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    {% if block.settings.layout == 'grid' %}
      padding-bottom: {{ block.settings.aspect_ratio }}%;
    {% elsif block.settings.layout == 'horizontal' %}
      padding-bottom: {{ block.settings.aspect_ratio }}%;
    {% endif %}
  }

  .ai-gallery-image-{{ ai_gen_id }} {
    {% if block.settings.layout == 'grid' or block.settings.layout == 'horizontal' %}
      position: absolute;
      top: 0;
      left: 0;
    {% endif %}
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-gallery-item-{{ ai_gen_id }}:hover .ai-gallery-image-{{ ai_gen_id }} {
    {% if block.settings.hover_effect == 'zoom' %}
      transform: scale(1.05);
    {% elsif block.settings.hover_effect == 'fade' %}
      opacity: 0.8;
    {% endif %}
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} {
    {% if block.settings.layout == 'grid' or block.settings.layout == 'horizontal' %}
      position: absolute;
      top: 0;
      left: 0;
    {% endif %}
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
  }

  {% if block.settings.show_captions %}
    .ai-gallery-item-{{ ai_gen_id }}:hover .ai-gallery-overlay-{{ ai_gen_id }} {
      opacity: 1;
    }
  {% endif %}

  .ai-gallery-caption-{{ ai_gen_id }} {
    color: {{ block.settings.caption_color }};
    font-size: {{ block.settings.caption_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-gallery-lightbox-trigger-{{ ai_gen_id }} {
    cursor: pointer;
  }

  .ai-gallery-lightbox-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-gallery-lightbox-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .ai-gallery-lightbox-content-{{ ai_gen_id }} {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-lightbox-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .ai-gallery-lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 40px;
    cursor: pointer;
    padding: 10px;
    line-height: 1;
    z-index: 10000;
  }

  .ai-gallery-lightbox-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #ffffff;
    font-size: 30px;
    cursor: pointer;
    padding: 20px;
    transition: background 0.3s ease;
  }

  .ai-gallery-lightbox-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .ai-gallery-lightbox-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-gallery-lightbox-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-gallery-lightbox-caption-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #ffffff;
    font-size: 16px;
    text-align: center;
    max-width: 80%;
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-container-{{ ai_gen_id }} {
      {% if block.settings.layout == 'grid' or block.settings.layout == 'masonry' %}
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      {% endif %}
    }

    {% if block.settings.layout == 'masonry' %}
      .ai-gallery-item-{{ ai_gen_id }} {
        grid-row: span 2 !important;
      }
    {% endif %}

    .ai-gallery-lightbox-nav-{{ ai_gen_id }} {
      font-size: 24px;
      padding: 15px;
    }

    .ai-gallery-lightbox-close-{{ ai_gen_id }} {
      font-size: 30px;
    }
  }
{% endstyle %}

<image-gallery-{{ ai_gen_id }} class="ai-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gallery-container-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign image = block.settings[image_key]
        assign caption = block.settings[caption_key]
      %}

      {% if image != blank %}
        <div class="ai-gallery-item-{{ ai_gen_id }} {% if block.settings.enable_lightbox %}ai-gallery-lightbox-trigger-{{ ai_gen_id }}{% endif %}" data-index="{{ forloop.index0 }}">
          <div class="ai-gallery-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-gallery-image-{{ ai_gen_id }}"
            >
            {% if block.settings.show_captions and caption != blank %}
              <div class="ai-gallery-overlay-{{ ai_gen_id }}">
                <p class="ai-gallery-caption-{{ ai_gen_id }}">{{ caption }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if block.settings.image_1 == blank and block.settings.image_2 == blank and block.settings.image_3 == blank %}
      {% for i in (1..6) %}
        <div class="ai-gallery-item-{{ ai_gen_id }}">
          <div class="ai-gallery-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-gallery-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if block.settings.enable_lightbox %}
    <div class="ai-gallery-lightbox-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Image gallery lightbox">
      <button class="ai-gallery-lightbox-close-{{ ai_gen_id }}" aria-label="Close lightbox">&times;</button>
      <button class="ai-gallery-lightbox-nav-{{ ai_gen_id }} ai-gallery-lightbox-prev-{{ ai_gen_id }}" aria-label="Previous image">&lsaquo;</button>
      <div class="ai-gallery-lightbox-content-{{ ai_gen_id }}">
        <img src="" alt="" class="ai-gallery-lightbox-image-{{ ai_gen_id }}">
        <div class="ai-gallery-lightbox-caption-{{ ai_gen_id }}"></div>
      </div>
      <button class="ai-gallery-lightbox-nav-{{ ai_gen_id }} ai-gallery-lightbox-next-{{ ai_gen_id }}" aria-label="Next image">&rsaquo;</button>
    </div>
  {% endif %}
</image-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.images = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.collectImages();
        
        if (this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}')) {
          this.setupLightbox();
        }
      }

      collectImages() {
        const items = this.querySelectorAll('.ai-gallery-item-{{ ai_gen_id }}');
        items.forEach((item) => {
          const img = item.querySelector('.ai-gallery-image-{{ ai_gen_id }}');
          const caption = item.querySelector('.ai-gallery-caption-{{ ai_gen_id }}');
          if (img) {
            this.images.push({
              src: img.src,
              alt: img.alt,
              caption: caption ? caption.textContent : ''
            });
          }
        });
      }

      setupLightbox() {
        const lightbox = this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}');
        const lightboxImage = lightbox.querySelector('.ai-gallery-lightbox-image-{{ ai_gen_id }}');
        const lightboxCaption = lightbox.querySelector('.ai-gallery-lightbox-caption-{{ ai_gen_id }}');
        const closeBtn = lightbox.querySelector('.ai-gallery-lightbox-close-{{ ai_gen_id }}');
        const prevBtn = lightbox.querySelector('.ai-gallery-lightbox-prev-{{ ai_gen_id }}');
        const nextBtn = lightbox.querySelector('.ai-gallery-lightbox-next-{{ ai_gen_id }}');
        const triggers = this.querySelectorAll('.ai-gallery-lightbox-trigger-{{ ai_gen_id }}');

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            this.currentIndex = parseInt(trigger.dataset.index);
            this.openLightbox();
          });
        });

        closeBtn.addEventListener('click', () => {
          this.closeLightbox();
        });

        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) {
            this.closeLightbox();
          }
        });

        prevBtn.addEventListener('click', () => {
          this.navigateLightbox(-1);
        });

        nextBtn.addEventListener('click', () => {
          this.navigateLightbox(1);
        });

        document.addEventListener('keydown', (e) => {
          if (!lightbox.classList.contains('active')) return;
          
          if (e.key === 'Escape') {
            this.closeLightbox();
          } else if (e.key === 'ArrowLeft') {
            this.navigateLightbox(-1);
          } else if (e.key === 'ArrowRight') {
            this.navigateLightbox(1);
          }
        });
      }

      openLightbox() {
        const lightbox = this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}');
        const lightboxImage = lightbox.querySelector('.ai-gallery-lightbox-image-{{ ai_gen_id }}');
        const lightboxCaption = lightbox.querySelector('.ai-gallery-lightbox-caption-{{ ai_gen_id }}');
        
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
        
        this.updateLightboxImage();
      }

      closeLightbox() {
        const lightbox = this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}');
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      navigateLightbox(direction) {
        this.currentIndex = (this.currentIndex + direction + this.images.length) % this.images.length;
        this.updateLightboxImage();
      }

      updateLightboxImage() {
        const lightbox = this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}');
        const lightboxImage = lightbox.querySelector('.ai-gallery-lightbox-image-{{ ai_gen_id }}');
        const lightboxCaption = lightbox.querySelector('.ai-gallery-lightbox-caption-{{ ai_gen_id }}');
        const currentImage = this.images[this.currentIndex];
        
        lightboxImage.src = currentImage.src;
        lightboxImage.alt = currentImage.alt;
        lightboxCaption.textContent = currentImage.caption;
      }
    }

    customElements.define('image-gallery-{{ ai_gen_id }}', ImageGallery{{ ai_gen_id }});
  })();
</script>

