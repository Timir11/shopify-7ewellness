{% doc %}
  @prompt
    Create a promotional badge for collection page product cards that shows a custom GIF image on the left side followed by text on the right. The badge should only display on products tagged with PREORDER20%. Include settings to upload the GIF file and customize the badge text, positioning, and styling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.vertical_position }}%;
    left: {{ block.settings.horizontal_position }}%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-promo-badge-gif-{{ ai_gen_id }} {
    width: {{ block.settings.gif_size }}px;
    height: {{ block.settings.gif_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-badge-gif-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-promo-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.2;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-badge-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.8 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-promo-badge-gif-{{ ai_gen_id }} {
      width: {{ block.settings.gif_size | times: 0.8 }}px;
      height: {{ block.settings.gif_size | times: 0.8 }}px;
    }

    .ai-promo-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

{% if product.tags contains 'PREORDER20%' %}
  <div class="ai-promo-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.gif_image %}
      <div class="ai-promo-badge-gif-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.gif_image | image_url }}"
          alt="{{ block.settings.badge_text | escape }}"
          loading="lazy"
          width="{{ block.settings.gif_size }}"
          height="{{ block.settings.gif_size }}"
        >
      </div>
    {% endif %}
    {% if block.settings.badge_text != blank %}
      <div class="ai-promo-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Promotional badge",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Badge content"
    },
    {
      "type": "image_picker",
      "id": "gif_image",
      "label": "GIF image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Pre-Order 20% Off"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "horizontal_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Horizontal position",
      "default": 15
    },
    {
      "type": "range",
      "id": "vertical_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Vertical position",
      "default": 10
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "gif_size",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "GIF size",
      "default": 24
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Spacing between GIF and text",
      "default": 8
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#231f20"
    }
  ],
  "presets": [
    {
      "name": "Promotional badge"
    }
  ]
}
{% endschema %}