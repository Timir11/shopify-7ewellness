{% doc %}
  @prompt
    gallery
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-gallery-container-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.gap }}px;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
  }

  .ai-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.placeholder_bg }};
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-gallery-item-{{ ai_gen_id }}:hover {
    transform: scale(1.0{{ block.settings.hover_scale }});
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {% if block.settings.aspect_ratio == 'natural' %}100%{% elsif block.settings.aspect_ratio == 'square' %}100%{% elsif block.settings.aspect_ratio == 'portrait' %}133%{% elsif block.settings.aspect_ratio == 'landscape' %}66%{% endif %};
  }

  .ai-gallery-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,{{ block.settings.overlay_opacity }}), transparent);
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-gallery-item-{{ ai_gen_id }}:hover .ai-gallery-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-gallery-caption-{{ ai_gen_id }} {
    color: {{ block.settings.caption_color }};
    font-size: {{ block.settings.caption_size }}px;
    margin: 0;
  }

  .ai-gallery-lightbox-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-gallery-lightbox-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .ai-gallery-lightbox-content-{{ ai_gen_id }} {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gallery-lightbox-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .ai-gallery-lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 40px;
    cursor: pointer;
    padding: 10px;
    line-height: 1;
    z-index: 10000;
  }

  .ai-gallery-lightbox-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-gallery-lightbox-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #ffffff;
    font-size: 30px;
    cursor: pointer;
    padding: 20px 15px;
    z-index: 10000;
    transition: background 0.3s ease;
  }

  .ai-gallery-lightbox-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .ai-gallery-lightbox-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-gallery-lightbox-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-gallery-lightbox-caption-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #ffffff;
    font-size: 16px;
    text-align: center;
    max-width: 80%;
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap | times: 0.7 }}px;
    }

    .ai-gallery-lightbox-nav-{{ ai_gen_id }} {
      font-size: 24px;
      padding: 15px 10px;
    }

    .ai-gallery-lightbox-close-{{ ai_gen_id }} {
      font-size: 30px;
      top: 10px;
      right: 10px;
    }
  }
{% endstyle %}

<image-gallery-{{ ai_gen_id }} class="ai-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gallery-container-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign image = block.settings[image_key]
        assign caption = block.settings[caption_key]
      %}
      
      {% if image != blank %}
        <div class="ai-gallery-item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
          <div class="ai-gallery-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-gallery-image-{{ ai_gen_id }}"
            >
            {% if caption != blank and block.settings.show_captions %}
              <div class="ai-gallery-overlay-{{ ai_gen_id }}">
                <p class="ai-gallery-caption-{{ ai_gen_id }}">{{ caption }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.enable_lightbox %}
    <div class="ai-gallery-lightbox-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Image gallery lightbox">
      <button class="ai-gallery-lightbox-close-{{ ai_gen_id }}" aria-label="Close lightbox">&times;</button>
      <button class="ai-gallery-lightbox-nav-{{ ai_gen_id }} ai-gallery-lightbox-prev-{{ ai_gen_id }}" aria-label="Previous image">&#8249;</button>
      <div class="ai-gallery-lightbox-content-{{ ai_gen_id }}">
        <img src="" alt="" class="ai-gallery-lightbox-image-{{ ai_gen_id }}">
      </div>
      <button class="ai-gallery-lightbox-nav-{{ ai_gen_id }} ai-gallery-lightbox-next-{{ ai_gen_id }}" aria-label="Next image">&#8250;</button>
      <div class="ai-gallery-lightbox-caption-{{ ai_gen_id }}"></div>
    </div>
  {% endif %}
</image-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.images = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-gallery-item-{{ ai_gen_id }}');
        this.lightbox = this.querySelector('.ai-gallery-lightbox-{{ ai_gen_id }}');
        
        if (!this.lightbox) return;

        this.lightboxImage = this.querySelector('.ai-gallery-lightbox-image-{{ ai_gen_id }}');
        this.lightboxCaption = this.querySelector('.ai-gallery-lightbox-caption-{{ ai_gen_id }}');
        this.closeBtn = this.querySelector('.ai-gallery-lightbox-close-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-gallery-lightbox-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-gallery-lightbox-next-{{ ai_gen_id }}');

        this.collectImages();
        this.setupEventListeners();
      }

      collectImages() {
        this.items.forEach((item) => {
          const img = item.querySelector('.ai-gallery-image-{{ ai_gen_id }}');
          const caption = item.querySelector('.ai-gallery-caption-{{ ai_gen_id }}');
          
          if (img) {
            this.images.push({
              src: img.src.replace(/width=\d+/, 'width=2000'),
              alt: img.alt,
              caption: caption ? caption.textContent : ''
            });
          }
        });
      }

      setupEventListeners() {
        this.items.forEach((item, index) => {
          item.addEventListener('click', () => {
            this.openLightbox(index);
          });
        });

        if (this.closeBtn) {
          this.closeBtn.addEventListener('click', () => {
            this.closeLightbox();
          });
        }

        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => {
            this.showPrevious();
          });
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => {
            this.showNext();
          });
        }

        if (this.lightbox) {
          this.lightbox.addEventListener('click', (e) => {
            if (e.target === this.lightbox) {
              this.closeLightbox();
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (!this.lightbox.classList.contains('active')) return;
          
          if (e.key === 'Escape') {
            this.closeLightbox();
          } else if (e.key === 'ArrowLeft') {
            this.showPrevious();
          } else if (e.key === 'ArrowRight') {
            this.showNext();
          }
        });
      }

      openLightbox(index) {
        this.currentIndex = index;
        this.updateLightboxImage();
        this.lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeLightbox() {
        this.lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      showPrevious() {
        this.currentIndex = (this.currentIndex - 1 + this.images.length) % this.images.length;
        this.updateLightboxImage();
      }

      showNext() {
        this.currentIndex = (this.currentIndex + 1) % this.images.length;
        this.updateLightboxImage();
      }

      updateLightboxImage() {
        const image = this.images[this.currentIndex];
        this.lightboxImage.src = image.src;
        this.lightboxImage.alt = image.alt;
        this.lightboxCaption.textContent = image.caption;
      }
    }

    customElements.define('image-gallery-{{ ai_gen_id }}', ImageGallery{{ ai_gen_id }});
  })();
</script>

