{% doc %}
  @prompt
    create 6 block grid image box with text layout in 1 horizontal row all will have seperate link to add
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-grid-box-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-grid-box-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-grid-box-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-grid-box-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-grid-box-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grid-box-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grid-box-text-{{ ai_gen_id }} {
    margin-top: {{ block.settings.text_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .ai-grid-box-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-grid-box-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<div class="ai-grid-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-box-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign text_key = 'text_' | append: i
        assign link_key = 'link_' | append: i
        
        assign item_image = block.settings[image_key]
        assign item_text = block.settings[text_key]
        assign item_link = block.settings[link_key]
      %}
      
      <a 
        href="{{ item_link | default: '#' }}" 
        class="ai-grid-box-item-{{ ai_gen_id }}"
      >
        <div class="ai-grid-box-image-wrapper-{{ ai_gen_id }}">
          {% if item_image %}
            <img
              src="{{ item_image | image_url: width: 600 }}"
              alt="{{ item_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        
        {% if item_text != blank %}
          <div class="ai-grid-box-text-{{ ai_gen_id }}">
            {{ item_text }}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

