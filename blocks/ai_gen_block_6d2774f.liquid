{% doc %}
  @prompt
    hero slider which support image+ video media and upload or both desktop and mobile , just to upload media no text button etc, just upload media for mobile and desktop and add nav link, change the ratio to upload for desktop to 1920by 640 and mobile 480by640
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 640;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__wrapper-{{ ai_gen_id }} {
      aspect-ratio: 480 / 640;
    }
  }

  .ai-hero-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-hero-slider__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-hero-slider__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-slider__media-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-slider__media-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__media-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-slider__media-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }

  .ai-hero-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .ai-hero-slider__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-hero-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-hero-slider__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_color }};
    color: {{ block.settings.arrow_icon_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-hero-slider__arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-hero-slider__arrow--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-hero-slider__arrow--next-{{ ai_gen_id }} {
    right: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-hero-slider__arrow--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-hero-slider__arrow--next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-hero-slider__controls-{{ ai_gen_id }} {
      bottom: 20px;
    }
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-hero-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<hero-slider-{{ ai_gen_id }}
  class="ai-hero-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-hero-slider__track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
          assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
          assign desktop_video_key = 'slide_' | append: i | append: '_desktop_video'
          assign mobile_video_key = 'slide_' | append: i | append: '_mobile_video'
          assign media_type_key = 'slide_' | append: i | append: '_media_type'
          assign link_key = 'slide_' | append: i | append: '_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign desktop_image = block.settings[desktop_image_key]
          assign mobile_image = block.settings[mobile_image_key]
          assign desktop_video = block.settings[desktop_video_key]
          assign mobile_video = block.settings[mobile_video_key]
          assign media_type = block.settings[media_type_key]
          assign link = block.settings[link_key]
        %}

        {% if slide_enabled %}
          <div class="ai-hero-slider__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if link != blank %}
              <a href="{{ link }}" class="ai-hero-slider__link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-hero-slider__link-{{ ai_gen_id }}">
            {% endif %}

              {% if media_type == 'image' %}
                {% if desktop_image != blank %}
                  <img
                    src="{{ desktop_image | image_url: width: 2000 }}"
                    alt="{{ desktop_image.alt | escape }}"
                    loading="lazy"
                    width="{{ desktop_image.width }}"
                    height="{{ desktop_image.height }}"
                    class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-desktop-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-desktop-{{ ai_gen_id }} ai-hero-slider__placeholder-{{ ai_gen_id }}">
                    {{ 'hero-apparel-1' | placeholder_svg_tag }}
                    <div class="ai-hero-slider__empty-state-{{ ai_gen_id }}">
                      Add a desktop image (1920x640) for slide {{ i }}
                    </div>
                  </div>
                {% endif %}

                {% if mobile_image != blank %}
                  <img
                    src="{{ mobile_image | image_url: width: 1000 }}"
                    alt="{{ mobile_image.alt | escape }}"
                    loading="lazy"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                    class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-mobile-{{ ai_gen_id }}"
                  >
                {% elsif desktop_image != blank %}
                  <img
                    src="{{ desktop_image | image_url: width: 1000 }}"
                    alt="{{ desktop_image.alt | escape }}"
                    loading="lazy"
                    width="{{ desktop_image.width }}"
                    height="{{ desktop_image.height }}"
                    class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-mobile-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-mobile-{{ ai_gen_id }} ai-hero-slider__placeholder-{{ ai_gen_id }}">
                    {{ 'hero-apparel-1' | placeholder_svg_tag }}
                    <div class="ai-hero-slider__empty-state-{{ ai_gen_id }}">
                      Add a mobile image (480x640) for slide {{ i }}
                    </div>
                  </div>
                {% endif %}
              {% else %}
                {% if desktop_video != blank %}
                  {{
                    desktop_video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      class: 'ai-hero-slider__media-' | append: ai_gen_id | append: ' ai-hero-slider__media-desktop-' | append: ai_gen_id
                  }}
                {% else %}
                  <div class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-desktop-{{ ai_gen_id }} ai-hero-slider__placeholder-{{ ai_gen_id }}">
                    {{ 'hero-apparel-1' | placeholder_svg_tag }}
                    <div class="ai-hero-slider__empty-state-{{ ai_gen_id }}">
                      Add a desktop video (1920x640) for slide {{ i }}
                    </div>
                  </div>
                {% endif %}

                {% if mobile_video != blank %}
                  {{
                    mobile_video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      class: 'ai-hero-slider__media-' | append: ai_gen_id | append: ' ai-hero-slider__media-mobile-' | append: ai_gen_id
                  }}
                {% elsif desktop_video != blank %}
                  {{
                    desktop_video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      class: 'ai-hero-slider__media-' | append: ai_gen_id | append: ' ai-hero-slider__media-mobile-' | append: ai_gen_id
                  }}
                {% else %}
                  <div class="ai-hero-slider__media-{{ ai_gen_id }} ai-hero-slider__media-mobile-{{ ai_gen_id }} ai-hero-slider__placeholder-{{ ai_gen_id }}">
                    {{ 'hero-apparel-1' | placeholder_svg_tag }}
                    <div class="ai-hero-slider__empty-state-{{ ai_gen_id }}">
                      Add a mobile video (480x640) for slide {{ i }}
                    </div>
                  </div>
                {% endif %}
              {% endif %}

            {% if link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow--prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-hero-slider__arrow-{{ ai_gen_id }} ai-hero-slider__arrow--next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-hero-slider__controls-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</hero-slider-{{ ai_gen_id }}>

<script>
  (function () {
    class HeroSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-hero-slider__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-hero-slider__slide-{{ ai_gen_id }}');
        this.totalSlides = this.slides.length;
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        if (this.totalSlides === 0) return;

        this.setupControls();
        this.setupArrows();
        this.goToSlide(0);

        if (this.autoplay && this.totalSlides > 1) {
          this.startAutoplay();
        }
      }

      setupControls() {
        const controlsContainer = this.querySelector('.ai-hero-slider__controls-{{ ai_gen_id }}');
        if (!controlsContainer) return;

        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-hero-slider__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.goToSlide(i);
            this.resetAutoplay();
          });
          controlsContainer.appendChild(dot);
        }

        this.dots = controlsContainer.querySelectorAll('.ai-hero-slider__dot-{{ ai_gen_id }}');
      }

      setupArrows() {
        const prevButton = this.querySelector('.ai-hero-slider__arrow--prev-{{ ai_gen_id }}');
        const nextButton = this.querySelector('.ai-hero-slider__arrow--next-{{ ai_gen_id }}');

        if (prevButton) {
          prevButton.addEventListener('click', () => {
            this.prevSlide();
            this.resetAutoplay();
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => {
            this.nextSlide();
            this.resetAutoplay();
          });
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        const offset = -index * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        if (this.dots) {
          this.dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(nextIndex);
      }

      prevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        if (this.autoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('hero-slider-{{ ai_gen_id }}', HeroSlider{{ ai_gen_id }});
  })();
</script>

