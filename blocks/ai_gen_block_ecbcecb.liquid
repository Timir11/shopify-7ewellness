{% doc %}
  @prompt
    i want one tab section where i'll have 2 tabs option, tab name can be editable and both tab should have a option to add a video content also one html block where html should render with respective tab, when user selects the tab, the tab button should be active with black background and white text (tab button).., tab buttons should align in the center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tab-section-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-tab-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    border-bottom: 1px solid #e0e0e0;
    justify-content: center;
  }

  .ai-tab-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: transparent;
    color: #231f20;
    border: none;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease;
    border-bottom: 3px solid transparent;
  }

  .ai-tab-button-{{ ai_gen_id }}:hover {
    background-color: #f5f5f5;
  }

  .ai-tab-button-{{ ai_gen_id }}.active {
    background-color: #000000;
    color: #ffffff;
    border-bottom-color: #000000;
  }

  .ai-tab-content-{{ ai_gen_id }} {
    display: none;
    padding: 20px 0;
  }

  .ai-tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin-bottom: 20px;
  }

  .ai-tab-video-wrapper-{{ ai_gen_id }} iframe,
  .ai-tab-video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-tab-html-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-tab-empty-state-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    background-color: #f9f9f9;
    border-radius: 8px;
    color: #666;
  }
{% endstyle %}

<tab-section-{{ ai_gen_id }} class="ai-tab-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tab-buttons-{{ ai_gen_id }}">
    <button
      class="ai-tab-button-{{ ai_gen_id }} active"
      data-tab="tab1"
      aria-selected="true"
      role="tab"
    >
      {{ block.settings.tab_1_name }}
    </button>
    <button
      class="ai-tab-button-{{ ai_gen_id }}"
      data-tab="tab2"
      aria-selected="false"
      role="tab"
    >
      {{ block.settings.tab_2_name }}
    </button>
  </div>

  <div class="ai-tab-content-{{ ai_gen_id }} active" data-tab-content="tab1" role="tabpanel">
    {% if block.settings.tab_1_video_url != blank %}
      <div class="ai-tab-video-wrapper-{{ ai_gen_id }}">
        {% if block.settings.tab_1_video_url contains 'youtube.com' or block.settings.tab_1_video_url contains 'youtu.be' %}
          {% assign video_id = block.settings.tab_1_video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        {% elsif block.settings.tab_1_video_url contains 'vimeo.com' %}
          {% assign video_id = block.settings.tab_1_video_url | split: '/' | last %}
          <iframe
            src="https://player.vimeo.com/video/{{ video_id }}"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {% else %}
          <video controls>
            <source src="{{ block.settings.tab_1_video_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.tab_1_html != blank %}
      <div class="ai-tab-html-content-{{ ai_gen_id }}">
        {{ block.settings.tab_1_html }}
      </div>
    {% endif %}

    {% if block.settings.tab_1_video_url == blank and block.settings.tab_1_html == blank %}
      <div class="ai-tab-empty-state-{{ ai_gen_id }}">
        Add video URL or HTML content for Tab 1
      </div>
    {% endif %}
  </div>

  <div class="ai-tab-content-{{ ai_gen_id }}" data-tab-content="tab2" role="tabpanel">
    {% if block.settings.tab_2_video_url != blank %}
      <div class="ai-tab-video-wrapper-{{ ai_gen_id }}">
        {% if block.settings.tab_2_video_url contains 'youtube.com' or block.settings.tab_2_video_url contains 'youtu.be' %}
          {% assign video_id = block.settings.tab_2_video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        {% elsif block.settings.tab_2_video_url contains 'vimeo.com' %}
          {% assign video_id = block.settings.tab_2_video_url | split: '/' | last %}
          <iframe
            src="https://player.vimeo.com/video/{{ video_id }}"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {% else %}
          <video controls>
            <source src="{{ block.settings.tab_2_video_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.tab_2_html != blank %}
      <div class="ai-tab-html-content-{{ ai_gen_id }}">
        {{ block.settings.tab_2_html }}
      </div>
    {% endif %}

    {% if block.settings.tab_2_video_url == blank and block.settings.tab_2_html == blank %}
      <div class="ai-tab-empty-state-{{ ai_gen_id }}">
        Add video URL or HTML content for Tab 2
      </div>
    {% endif %}
  </div>
</tab-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TabSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-tab-button-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tab-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabId = button.getAttribute('data-tab');
            this.switchTab(tabId);
          });
        });
      }

      switchTab(tabId) {
        this.buttons.forEach((btn) => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
          } else {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
          }
        });

        this.contents.forEach((content) => {
          if (content.getAttribute('data-tab-content') === tabId) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }
    }

    customElements.define('tab-section-{{ ai_gen_id }}', TabSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_name",
      "label": "Tab 1 name",
      "default": "Tab 1"
    },
    {
      "type": "url",
      "id": "tab_1_video_url",
      "label": "Video URL"
    },
    {
      "type": "html",
      "id": "tab_1_html",
      "label": "HTML content"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_name",
      "label": "Tab 2 name",
      "default": "Tab 2"
    },
    {
      "type": "url",
      "id": "tab_2_video_url",
      "label": "Video URL"
    },
    {
      "type": "html",
      "id": "tab_2_html",
      "label": "HTML content"
    }
  ],
  "presets": [
    {
      "name": "Video tabs"
    }
  ]
}
{% endschema %}
