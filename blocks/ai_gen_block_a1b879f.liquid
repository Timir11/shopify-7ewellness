{% doc %}
  @prompt
    i want one tab section where i'll have 2 tabs option, tab name can be editable and both tab should have a option to add a video content also one html block where html should render with respective tab, when user selects the tab, the tab button should be active with black background and white text (tab button).., tab buttons should align in the center, on video url - youtube video should render inside the respective tab and these content should align in center, and these tabs should be responsive, when it comes to mobile. the video should display 16:9 ratio, and tabs to align in a same line on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tab-section-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-tab-buttons-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: nowrap;
  }

  .ai-tab-button-{{ ai_gen_id }} {
    padding: 12px 30px;
    background-color: transparent;
    color: {{ block.settings.inactive_text_color }};
    border: 2px solid {{ block.settings.inactive_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-tab-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_bg_color }};
    color: {{ block.settings.hover_text_color }};
  }

  .ai-tab-button-{{ ai_gen_id }}.active {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .ai-tab-content-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .ai-tab-video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-tab-html-content-{{ ai_gen_id }} {
    width: 100%;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-tab-buttons-{{ ai_gen_id }} {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-tab-buttons-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-tab-button-{{ ai_gen_id }} {
      padding: 10px 20px;
      font-size: 14px;
      flex-shrink: 0;
    }

    .ai-tab-section-{{ ai_gen_id }} {
      padding: 30px 15px;
    }
  }
{% endstyle %}

<tab-section-{{ ai_gen_id }} class="ai-tab-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tab-buttons-{{ ai_gen_id }}">
    <button
      class="ai-tab-button-{{ ai_gen_id }} active"
      data-tab="tab1"
      aria-label="{{ block.settings.tab_1_name }}"
    >
      {{ block.settings.tab_1_name }}
    </button>
    <button
      class="ai-tab-button-{{ ai_gen_id }}"
      data-tab="tab2"
      aria-label="{{ block.settings.tab_2_name }}"
    >
      {{ block.settings.tab_2_name }}
    </button>
  </div>

  <div class="ai-tab-content-{{ ai_gen_id }} active" data-content="tab1">
    {% if block.settings.tab_1_video_url != blank %}
      <div class="ai-tab-video-wrapper-{{ ai_gen_id }}">
        {% assign video_id_1 = block.settings.tab_1_video_url | split: 'v=' | last | split: '&' | first %}
        {% if video_id_1 == block.settings.tab_1_video_url %}
          {% assign video_id_1 = block.settings.tab_1_video_url | split: 'youtu.be/' | last | split: '?' | first %}
        {% endif %}
        <iframe
          src="https://www.youtube.com/embed/{{ video_id_1 }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    {% endif %}
    {% if block.settings.tab_1_html != blank %}
      <div class="ai-tab-html-content-{{ ai_gen_id }}">
        {{ block.settings.tab_1_html }}
      </div>
    {% endif %}
  </div>

  <div class="ai-tab-content-{{ ai_gen_id }}" data-content="tab2">
    {% if block.settings.tab_2_video_url != blank %}
      <div class="ai-tab-video-wrapper-{{ ai_gen_id }}">
        {% assign video_id_2 = block.settings.tab_2_video_url | split: 'v=' | last | split: '&' | first %}
        {% if video_id_2 == block.settings.tab_2_video_url %}
          {% assign video_id_2 = block.settings.tab_2_video_url | split: 'youtu.be/' | last | split: '?' | first %}
        {% endif %}
        <iframe
          src="https://www.youtube.com/embed/{{ video_id_2 }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    {% endif %}
    {% if block.settings.tab_2_html != blank %}
      <div class="ai-tab-html-content-{{ ai_gen_id }}">
        {{ block.settings.tab_2_html }}
      </div>
    {% endif %}
  </div>
</tab-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TabSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-tab-button-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tab-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabId = button.getAttribute('data-tab');
            this.switchTab(tabId);
          });
        });
      }

      switchTab(tabId) {
        this.buttons.forEach((btn) => {
          btn.classList.remove('active');
        });

        this.contents.forEach((content) => {
          content.classList.remove('active');
        });

        const activeButton = this.querySelector(`[data-tab="${tabId}"]`);
        const activeContent = this.querySelector(`[data-content="${tabId}"]`);

        if (activeButton) {
          activeButton.classList.add('active');
        }

        if (activeContent) {
          activeContent.classList.add('active');
        }
      }
    }

    customElements.define('tab-section-{{ ai_gen_id }}', TabSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_name",
      "label": "Tab 1 name",
      "default": "Tab 1"
    },
    {
      "type": "url",
      "id": "tab_1_video_url",
      "label": "YouTube video URL"
    },
    {
      "type": "html",
      "id": "tab_1_html",
      "label": "HTML content"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_name",
      "label": "Tab 2 name",
      "default": "Tab 2"
    },
    {
      "type": "url",
      "id": "tab_2_video_url",
      "label": "YouTube video URL"
    },
    {
      "type": "html",
      "id": "tab_2_html",
      "label": "HTML content"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Border radius",
      "default": 5
    },
    {
      "type": "color",
      "id": "inactive_text_color",
      "label": "Inactive text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "inactive_border_color",
      "label": "Inactive border color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Hover background color",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Hover text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video tabs"
    }
  ]
}
{% endschema %}
