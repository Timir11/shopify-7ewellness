{%- assign fixed_aspect_ratio = false -%}
{% unless image_size == 'natural' %}
  {%- assign fixed_aspect_ratio = true -%}
{% endunless %}

<article class="article-listing articleListing" data-aos>
  {%- if article.image -%}
    <div class="article__image-wrap">
      {% assign pop_up_id = article.id | append: product.id %}
      <!-- <a href="{{ article.url }}" class="article__grid-image"> -->
      <a href="#" class="popup-link" data-target="Product-popup-content-{{ pop_up_id }}">
        {%- if fixed_aspect_ratio -%}
          <div class="image-wrap">
            <div
              class="grid__image-ratio grid__image-ratio--cover grid__image-ratio--{{ image_size }}"
            >
              {%- render 'image-element',
                img: article.image,
                sizes: sizes,
                sizeVariable: sizeVariable,
                fallback: fallback,
                classes: classes
              -%}
            </div>
          </div>
        {%- else -%}
          <!-- style="height: 0; padding-bottom: {{ 100 | divided_by: article.image.aspect_ratio }}%;" -->
          <div
            class="image-wrap"
          >
            {%- render 'image-element',
              img: article.image,
              sizes: sizes,
              sizeVariable: sizeVariable,
              fallback: fallback,
              widths: '180, 360, 540, 720, 900, 1080'
            -%}
          </div>
        {%- endif -%}
      </a>
    </div>
    <div class="article__content">
    <div class="article__content-meta">
      <div class="article__date">
        {%- assign first_item = true -%}
        {%- if show_comments and article.comments_count > 0 -%}
          {% unless first_item %} &middot; {% endunless %}
          {%- assign first_item = false -%}
          <a href="{{ article.url }}#comments">
            {{ 'blogs.comments.with_count' | t: count: article.comments_count }}
          </a>
        {%- endif -%}
        {%- if show_date -%}
          {% unless first_item %} &middot; {% endunless %}
          {%- assign first_item = false -%}
          {{ article.published_at | time_tag: format: 'month_day_year' }}
        {%- endif -%}
      </div>

      <div class="h3">
        <a href="#" class="popup-link" data-target="Product-popup-content-{{ pop_up_id }}">{{ article.title }}</a>
      </div>

      {%- if show_author -%}
        <div class="article__author">by {{ article.author }}</div>
      {%- endif -%}
    </div>

    {%- if show_excerpt and article.excerpt.size > 0 -%}
      <div class="rte rte--block">
        {{ article.excerpt }}
      </div>
    {%- endif -%}

    {%- if show_tags and article.tags.size > 0 -%}
        <div class="articaltags">
          {%- for tag in article.tags -%}
            {% if tag contains '_' %}
              {%- assign tag_starts_with = tag | slice: 0 -%}
              {% if tag_starts_with == '_' -%}
                {%- if tag_count %}{%- assign tag_count = tag_count | minus: 1 | at_least: 0 -%}{% endif -%}
                {%- continue -%}
              {%- endif -%}
            {%- endif %}
            {% unless blog.template_suffix == 'tutorials' %}
              {% unless first_item %} &middot; {% endunless %}
              {%- assign first_item = false -%}
            {% endunless %}
            <a class="linksarticle" href="{{ blog.url }}/tagged/{{ tag | handle }}">
              {{ tag }}
            </a>
          {%- endfor -%}
        </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</article>
<div id="Product-popup-content-{{ pop_up_id }}" class="popup">
  <div class="popup-content">
    <span class="close">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
    </span>
    <div>{{ article.content }}</div>
  </div>
</div>
