<div class="cart__item" data-key="{{ product.key }}">
  <div class="cart__item--image" data-aos>
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap" style="display: block; height: 0; padding-bottom: {{ 100 | divided_by: product.image.aspect_ratio }}%;">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback,
        -%}
      </a>
    {% endif %}
  </div>

  <div class="cart__item--details">
    <div class="cart__item--name">
      {% if product.product.tags contains "on_Professionals Only" %}
        <div class="cart-label-professional">
          For Licensed Professionals Only
        </div>
      {% endif %}

      <a href="{{ product.url }}" class="cart__product-name">
        {{ product.product.title }}
      </a>
      {% comment %} <a href="{{ product.url }}" class="cart__product-name">
        {{ product.product.title }}
      </a> {% endcomment %}
  <!-- <span class="cart__price cart__discount">{{ product.final_price | money }}</span> -->
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div><span>{{ option.name }}:</span> {{ option.value }}</div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      {% comment %} Laborday sale changes {% endcomment %}
      {%- if product.line_level_discount_allocations != blank -%}
        {%- for discount_allocation in product.line_level_discount_allocations -%}
      <small class="cart__discount">
        <span class="cart-discount-label">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="16px"><!--!Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M96.5 160L96.5 309.5C96.5 326.5 103.2 342.8 115.2 354.8L307.2 546.8C332.2 571.8 372.7 571.8 397.7 546.8L547.2 397.3C572.2 372.3 572.2 331.8 547.2 306.8L355.2 114.8C343.2 102.7 327 96 310 96L160.5 96C125.2 96 96.5 124.7 96.5 160zM208.5 176C226.2 176 240.5 190.3 240.5 208C240.5 225.7 226.2 240 208.5 240C190.8 240 176.5 225.7 176.5 208C176.5 190.3 190.8 176 208.5 176z"/></svg>
          {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
          </span>
        </small>
        {%- endfor -%}
      {%- endif -%}
      
      {%- assign property_size = product.properties | size -%}
      {%- if property_size > 0 -%}
        {%- for p in product.properties -%}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {%- unless p.last == blank or first_character_in_key == '_' -%}
            <div class="cart__item--properties">
              <span>{{ p.first }}:</span>
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {% if product.selling_plan_allocation.selling_plan.name %} 
    <div class="skio-cart-variant-name">
      {{ product.selling_plan_allocation.selling_plan.name }}
    </div>
    {% endif %}

      <!-- <small>Premium Lifetime Membership</small> -->
    <div class="cart__item--qty">
      <div class="js-qty__wrapper">
        <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
        <input type="text"
          id="cart_updates_{{ product.key }}"
          name="updates[]"
          class="js-qty__num"
          value="{{ product.quantity }}"
          min="0"
          pattern="[0-9]*"
          data-id="{{ product.key }}">
        <button type="button"
          class="js-qty__adjust js-qty__adjust--minus"
          aria-label="{{ 'cart.general.reduce_quantity' | t }}">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
            <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
        </button>
        <button type="button"
          class="js-qty__adjust js-qty__adjust--plus"
          aria-label="{{ 'cart.general.increase_quantity' | t }}">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
            <span class="icon__fallback-text" aria-hidden="true">+</span>
        </button>
      </div>
    </div>
    
    <div class="price cart__item--price cart__item-price-col text-right">
      {%- if product.original_price != product.final_price -%}
        <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
        <small class="cart__price cart__price--strikethrough">{{ product.original_price | money }}</small>
        <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
        <span class="cart__price cart__discount">{{ product.final_price | money }}</span>
      {%- else -%}
        <span class="cart__price">{{ product.original_price | money }}</span>
      {%- endif -%}

      {% comment %} {%- if product.line_level_discount_allocations != blank -%}
        {%- for discount_allocation in product.line_level_discount_allocations -%}
          <small class="cart__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small>
        {%- endfor -%}
      {%- endif -%} {% endcomment %}

      {%- if product.unit_price_measurement -%}
        {%- capture unit_price_base_unit -%}
          <span class="unit-price-base">
            {%- if product.unit_price_measurement -%}
              {%- if product.unit_price_measurement.reference_value != 1 -%}
                {{ product.unit_price_measurement.reference_value }}
              {%- endif -%}
              {{ product.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
        {%- endcapture -%}

        <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
      {%- endif -%}
    </div>

    {% comment %} <div class="remove-item-icon">      
      <a href="javascript:void(null)" class="remove" data-index="{{ product.id }}">
        <svg width="22" height="25" viewBox="0 0 22 25" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.48908 7.79745C1.46392 6.43058 2.43922 4.47998 4.14781 4.47998H17.6941C19.4027 4.47998 20.378 6.43058 19.3529 7.79745V7.79745C18.6052 8.7944 18.201 10.007 18.201 11.2531V17.6533C18.201 21.0996 15.4072 23.8933 11.961 23.8933H9.88098C6.43472 23.8933 3.64098 21.0996 3.64098 17.6533V11.2531C3.64098 10.007 3.23679 8.7944 2.48908 7.79745V7.79745Z" stroke="#D12F2F" stroke-width="1.56"/>
          <path d="M14.2314 17.7324L14.2314 10.4568" stroke="#D12F2F" stroke-width="1.56" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8.31934 17.7324L8.31934 10.4568" stroke="#D12F2F" stroke-width="1.56" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15.776 4.48009L15.2738 2.97346C14.8491 1.69943 13.6568 0.840088 12.3139 0.840088H9.53144C8.1885 0.840088 6.99622 1.69943 6.57155 2.97346L6.06934 4.48009" stroke="#D12F2F" stroke-width="1.56" stroke-linecap="round"/>
        </svg>
      </a>
    </div> {% endcomment %}
  </div>
</div>
