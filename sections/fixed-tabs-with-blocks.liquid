{% schema %}
{
  "name": "Fixed Tabs with Blocks",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "tab1_block",
      "name": "Tab One Content"
    },
    {
      "type": "tab2_block",
      "name": "Tab Two Content"
    }
  ],
  "presets": [
    {
      "name": "Fixed Tabs with Blocks",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .tab-buttons {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    overflow-x: auto;
    flex-wrap: nowrap;
  }
  .tab-button {
    cursor: pointer;
    padding: 10px 30px;
    border: 1px solid #ccc;
    margin: 0 5px;
    font-weight: 600;
    color: black;
    background: white;
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s;
    user-select: none;
  }
  .tab-button.active {
    background-color: black;
    color: white;
  }
  .tab-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  @media (max-width: 600px) {
    .tab-buttons {
      flex-wrap: nowrap;
    }
    .tab-button {
      flex: 0 0 auto;
    }
  }
</style>

<div class="tab-container">
  <div class="tab-buttons" role="tablist">
    <div id="tab1-btn" class="tab-button active" role="tab" tabindex="0" aria-controls="tab1"
      aria-selected="true" onclick="showTab('tab1')" onkeydown="if(event.key === 'Enter' || event.key === ' ') { showTab('tab1') }">
      Tab One
    </div>
    <div id="tab2-btn" class="tab-button" role="tab" tabindex="-1" aria-controls="tab2" aria-selected="false"
      onclick="showTab('tab2')" onkeydown="if(event.key === 'Enter' || event.key === ' ') { showTab('tab2') }">
      Tab Two
    </div>
  </div>

  <div id="tab1" class="tab-content" role="tabpanel" tabindex="0" aria-labelledby="tab1-btn" style="display: block;">
    {% for block in section.blocks %}
      {% if block.type == 'tab1_block' %}
        {% render block %}
      {% endif %}
    {% endfor %}
  </div>

  <div id="tab2" class="tab-content" role="tabpanel" tabindex="0" aria-labelledby="tab2-btn" style="display: none;">
    {% for block in section.blocks %}
      {% if block.type == 'tab2_block' %}
        {% render block %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  function showTab(tabId) {
    // Hide both tab contents
    ['tab1', 'tab2'].forEach(id => {
      document.getElementById(id).style.display = 'none';
      document.getElementById(id + '-btn').classList.remove('active');
      document.getElementById(id + '-btn').setAttribute('aria-selected', 'false');
      document.getElementById(id + '-btn').tabIndex = -1;
    });

    // Show the selected tab content and activate button
    document.getElementById(tabId).style.display = 'block';
    const btn = document.getElementById(tabId + '-btn');
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    btn.tabIndex = 0;
    btn.focus();
  }
</script>
