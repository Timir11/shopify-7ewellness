<div class="direct-sale-program-tabs">
  <div class="page-full p-0">
    <nav>
      <div class="nav nav-tabs" id="nav-tab" role="tablist">
        <a
          class="nav-item nav-link active"
          data-toggle="tab"
          href="#nav-01"
          role="tab"
          aria-controls="nav-01"
          aria-selected="true"
          >Program Overview</a
        >
        <a
          class="nav-item nav-link"
          data-toggle="tab"
          href="#nav-02"
          role="tab"
          aria-controls="nav-02"
          aria-selected="false"
          >Benefits</a
        >
        <a
          class="nav-item nav-link"
          data-toggle="tab"
          href="#nav-03"
          role="tab"
          aria-controls="nav-03"
          aria-selected="false"
          >Tools & Training</a
        >
      </div>
    </nav>
    <div class="direct-sale-section" id="nav-01">
      <div class="page-width">
        <div class="row align-items-center mb-5">
          <div class="col-lg-6">
            <div class="left_img">
              {% if section.settings.left_img != blank %}
                <img src="{{ section.settings.left_img | img_url: 'original' }}">
              {% endif %}
            </div>
          </div>
          <div class="col-lg-6">
            <div class="right_txt">
              {% if section.settings.title != blank %}
                <h3>{{ section.settings.title }}</h3>
              {% endif %}
              {% if section.settings.text != blank %}
                <p>{{ section.settings.text }}</p>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="program_overview">
          <div class="title">
            <h2>Program Overview</h2>
            <h4>The More You Sell, The More You Make!</h4>
            <p>
              Advance to our highest platinum tier to earn 15% commission, a free advanced Myolift MD device, and
              giftcards!
            </p>
          </div>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <td></td>
                  <td>
                    <img
                      src="https://cdn.shopify.com/s/files/1/2745/9950/files/devices_1_1.png?v=1725688623"
                      width=""
                      height=""
                    >
                  </td>
                  <td>
                    <img
                      src="https://cdn.shopify.com/s/files/1/2745/9950/files/devices_2.png?v=1725688596"
                      width=""
                      height=""
                    >
                  </td>
                  <td>
                    <img
                      src="https://cdn.shopify.com/s/files/1/2745/9950/files/devices_3_1.png?v=1725688623"
                      width=""
                      height=""
                    >
                  </td>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th>COMMISSION & BENEFITS</th>
                  <td>
                    <h4>STANDARD</h4>
                    <h6>When You Sell <b>$0 - $34,999</b></h6>
                  </td>
                  <td>
                    <h4>PRO</h4>
                    <h6>When You Sell <b>$35,000- $74,999</b></h6>
                  </td>
                  <td>
                    <h4>PLATINUM</h4>
                    <h6>When You Sell <b>$75,000+</b></h6>
                  </td>
                </tr>
                <tr>
                  <td><strong>COMMISSION</strong></td>
                  <td>10%</td>
                  <td>12%</td>
                  <td>15%</td>
                </tr>
                <tr>
                  <td><strong>LEADS</strong></td>
                  <td>10 MQL / Month</td>
                  <td>20 MQL / Month</td>
                  <td>50 MQL / Month</td>
                </tr>
                <tr>
                  <td><strong>PRODUCTS</strong></td>
                  <td>FREE Mini or QT at $2000</td>
                  <td>Myolift 600+ ($1,499 value)</td>
                  <td>Myolift MD ($6,500 value)</td>
                </tr>
                <tr>
                  <td><strong>GIFT CARD</strong></td>
                  <td>$100 7ewellness gift card for every $5k sold until Pro Status</td>
                  <td>$500 Visa or $1000 7eWellness Gift Card</td>
                  <td>$1000 Visa or $2000 7eWellness Gift Card</td>
                </tr>
                <tr>
                  <td><strong>VACATIONS</strong></td>
                  <td>------------</td>
                  <td>------------</td>
                  <td>Up to $2500 on your next vacation</td>
                </tr>
                <tr>
                  <th>TOOLS & TRAINING</th>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td><strong>WEBINARS</strong></td>
                  <td>Recurring webinars exclusively for 7e Wellness Sales Partners to learn, network and FAQs</td>
                  <td></td>
                  <td></td>
                </tr>
                <tr>
                  <td><strong>ON-SITE TRAINING</strong></td>
                  <td></td>
                  <td>1X / year</td>
                  <td>2 X / year</td>
                </tr>
                <tr>
                  <td><strong>SELLING TOOLKIT</strong></td>
                  <td>Digital Brochures</td>
                  <td>Digital Brochures</td>
                  <td>Digital Brochures</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="direct-sale-section" id="nav-02">
      <div class="page-width">
        <div class="direct_sale_benefits">
          <div class="title">
            <h2>Benefits</h2>
          </div>
          <div class="benefit_slider">
            <div class="benefit_slide_item">
              <div class="row align-items-center">
                <div class="col-lg-6">
                  <div class="left_img">
                    <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/two-women-wearing-black-dresses-with-word-back_1.png?v=1725696002">
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="right_txt">
                    <h3>Earn Up To 15% Commission</h3>
                    <p>Sales consultants start earning on every sale, and can make up to 15%.</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="benefit_slide_item">
              <div class="row align-items-center">
                <div class="col-lg-6">
                  <div class="left_img">
                    <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/hi_res-5d-7e_Wellness_r1_01C_3620_1.png?v=1725696002">
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="right_txt">
                    <h3>Earn Free MyoLift Devices</h3>
                    <p>
                      Get free product as you hit various sales targets, giving you professional microcurrent technology
                      to grow your business..
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <div class="benefit_slide_item">
              <div class="row align-items-center">
                <div class="col-lg-6">
                  <div class="left_img">
                    <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/IMG_8958_1.png?v=1725696002">
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="right_txt">
                    <h3>Get Expert Guidance and Much More!</h3>
                    <p>
                      From dedicated webinars, to free 7e Wellness certifications, we have you covered to become a
                      product expert in no time!
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="direct-sale-section" id="nav-03">
      <div class="page-width">
        <div class="direct_sale_training">
          <div class="title">
            <h2>
              Here's a Summary of Our 2 Week<br>
              Onboarding Process
            </h2>
          </div>
          <div class="row">
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/image-woman-sitting-computer-she-is-zoom-screen-show-boxes-with-images-ot_1_1.png?v=1725698467">
                <h5>Onboarding 1:1 with our team</h5>
              </div>
            </div>
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/Pooja_Johari_Headshot_1.png?v=1725698467">
                <h5>Overview of 7E with the founder, Pooja Johari</h5>
              </div>
            </div>
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/image_3.png?v=1725698467">
                <h5>Sales Process Video</h5>
              </div>
            </div>
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/image_2_3b282f71-20a6-4149-b475-72d8d15fad3c.png?v=1725698467">
                <h5>Device Training Video</h5>
              </div>
            </div>
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/at_home_device-1_1.png?v=1725698467">
                <h5>In-Depth Training on At-Home Devices - Led by Lead Esthetician, Sam Meyerson.</h5>
              </div>
            </div>
            <div class="col-lg-4 col-6">
              <div class="direct_sale_training_item">
                <img src="https://cdn.shopify.com/s/files/1/2745/9950/files/professional_device-1_1.png?v=1725698467">
                <h5>In-Depth Training on Professional Devices - Led by Lead Educator, Jacque Forte.</h5>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function(){
    $('.benefit_slider').slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      dots: true,
      arrows: false,
      autoplay: false,
      speed: 500,
      loop: true,
    });
    $( ".nav-link" ).click(function() {
        $("html, body").animate({ scrollTop: $($(this).attr("href")).offset().top - 80 }, 700);
    });
  })
</script>

{% schema %}
{
  "name": "Direct Sale Program Tabs",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_img",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Direct Sale Program Tabs"
    }
  ]
}
{% endschema %}
