{% paginate blog.articles by section.settings.post_limit %}

<div data-section-id="{{ section.id }}" data-section-type="blog">
  <div class="page-width page-content">

    <header class="section-header" data-aos>
      <h1 class="section-header__title appear-delay">
        {{ blog.title }}
      </h1>
      <p class="blog_description">Learn about the benefits of microcurrent, and how it's leveraged as a holistic treatment for mind, body and skin wellness</p>

      {%- if section.settings.blog_show_tag_filter -%}
        {%- if blog.tags.size > 0 -%}
          <select id="BlogTagFilter" class="medium-up--hide">
            <option value="/blogs/{{ blog.handle }}">All</option>
            {%- for tag in blog.all_tags -%}
              {% if tag contains "_" %}{%- assign tag_starts_with = tag | slice: 0 -%}{% if tag_starts_with == "_" %}{% if tag_count %}{%- assign tag_count = tag_count | minus: 1 | at_least: 0 -%}{% endif %}{% continue %}{% endif %}{% endif %}
              <option value="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}selected{% endif %}>{{ tag }}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.blog_show_rss -%}
        <a href="{{ shop.url }}{{ blog.url }}.atom" class="rss-link">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-rss" viewBox="0 0 20 20"><path fill="#444" d="M5.903 16.586a2.489 2.489 0 1 1-4.977 0 2.489 2.489 0 0 1 4.977 0zm7.053 2.489H9.43c0-4.688-3.817-8.505-8.505-8.505V7.044c6.638 0 12.031 5.393 12.031 12.031z"/><path fill="#444" d="M15.445 19.075c0-8.028-6.493-14.52-14.52-14.52V.925c10.019 0 18.15 8.131 18.15 18.15h-3.63z"/></svg>
          <span class="icon__fallback-text">RSS</span>
        </a>
      {%- endif -%}

    </header>

    {%- assign grid_item_width = 'medium-up--one-third' -%}
    {%- assign sizeVariable = '33vw' -%}
    {%- if section.settings.layout == 'feed' -%}
      {%- assign grid_item_width = 'medium-up--three-fifths medium-up--push-one-fifth' -%}
      {%- assign sizeVariable = '60vw' -%}
    {%- endif -%}
    <div class="grid small--hide">
      <div class="featured-blogs-section">
        <div class="grid__item">
          <h2>Featured Blogs</h2>
        </div>
        <div class="featured-blog-wrapper">
          {%- for article in blog.articles -%}
            {% if forloop.index == 1 %}
              <div class="grid__item medium-up--two-thirds">
                  <div class="blog-card">
                    {%- render 'article-grid-item',
                      article: article,
                      image_size: section.settings.blog_image_size,
                      show_excerpt: section.settings.blog_show_excerpt,
                      show_author: section.settings.blog_show_author,
                      show_date: section.settings.blog_show_date,
                      show_comments: section.settings.blog_show_comments,
                      show_tags: section.settings.blog_show_tags,
                      sizeVariable: sizeVariable,
                    -%}
                  </div>
              </div>
            {% endif %}
          {%- endfor -%}
          <div class="grid__item medium-up--one-third">
            {% for block in section.blocks %}
              <div class="blog-list trending-blog">
                {% if block.type == 'trending-blog' %}
                  {% if block.settings.title %}
                    <h3 class="trending_blog_title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {%- assign fetured_blog = blogs[block.settings.blog] -%}
                  {%- for article in fetured_blog.articles limit: block.settings.post_limit -%}
                    <div class="blog-item">
                      <a href="{{ article.url }}" class="article-image">
                        <div class="article-image-wrap">
                          <img src="{{ article.image | image_url  }}" width="144" height="115">
                        </div>
                        <div class="fetured_blog_content">
                          <p class="article__date">{{ article.published_at | time_tag: format: 'month_day_year' }}</p>
                          <h4><b>{{ article.title }}</b></h4>
                        </div>
                      </a>
                    </div>
                  {%- endfor -%}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="popular-blogs-section">
      <div class="grid small--hide">
        <div class="grid__item  medium-up--two-thirds">
          <h2>Popular</h2>
          {%- for article in blog.articles -%}
            {% if forloop.index == 2 or forloop.index == 3 %}
              <div class="grid__item medium-up--one-half">
                  <div class="blog-card">
                    {%- render 'article-grid-item',
                      article: article,
                      image_size: section.settings.blog_image_size,
                      show_excerpt: section.settings.blog_show_excerpt,
                      show_author: section.settings.blog_show_author,
                      show_date: section.settings.blog_show_date,
                      show_comments: section.settings.blog_show_comments,
                      show_tags: section.settings.blog_show_tags,
                      sizeVariable: sizeVariable,
                    -%}
                  </div>
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      
        <div class="grid__item medium-up--one-third">
          {% for block in section.blocks %}
            <div class="blog-list">
              {% if block.type == 'popular-blog' %}
                {% if block.settings.title %}
                  <h2 class="trending_blog_title">{{ block.settings.title }}</h2>
                {% endif %}
                {%- assign popular_blog = blogs[block.settings.blog] -%}
                {%- for article in popular_blog.articles limit: block.settings.post_limit -%}
                  <div class="blog-item">
                    <a href="{{ article.url }}" class="article-image">
                      <div class="article-image-wrap">
                        <img src="{{ article.image | image_url  }}" width="144" height="115">
                      </div>
                      <div class="fetured_blog_content">
                        <p class="article__date">{{ article.published_at | time_tag: format: 'month_day_year' }}</p>
                        <h4><b>{{ article.title }}</b></h4>
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
      
    {%- if section.settings.blog_show_tag_filter -%}
      {%- if blog.tags.size > 0 -%}
        <ul class="blog-nav-container small--hide">
          <li class="blog-nav-items  {% if request.path == blog.url %} active_tag{% endif %}">
            <a class="{% if request.path == blog.url %} active_link{% endif %}" href="/blogs/{{ blog.handle }}">ALL</a>
          </li>
          {%- for tag in blog.all_tags limit: 4 -%}
            {% if tag contains "_" %}
              {%- assign tag_starts_with = tag | slice: 0 -%}
              {% if tag_starts_with == "_" %}
                {% if tag_count %}
                  {%- assign tag_count = tag_count | minus: 1 | at_least: 0 -%}
                {% endif %}
                {% continue %}
              {% endif %}
            {% endif %}
            <li class="blog-nav-items {% if current_tags contains tag %}active_tag{% endif %}">
              <a class="{% if current_tags contains tag %}active_link{% endif %} " href="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
            </li>
          {%- endfor -%}

          {%- if blog.tags.size > 4 -%}
            <span class="load-more-btn" onclick="showMoreTags()">Load More</span>
          {%- endif -%}

          <ul class="blog-nav-container small--hide">
            <span id="more-tags" style="display: none;">
              {%- for tag in blog.all_tags offset: 4 -%}
                {% if tag contains "_" %}
                  {%- assign tag_starts_with = tag | slice: 0 -%}
                  {% if tag_starts_with == "_" %}
                    {% if tag_count %}
                      {%- assign tag_count = tag_count | minus: 1 | at_least: 0 -%}
                    {% endif %}
                    {% continue %}
                  {% endif %}
                {% endif %}
                  <li class="blog-nav-items {% if current_tags contains tag %}active_tag{% endif %}">
                    <a class="{% if current_tags contains tag %}active_link{% endif %} " href="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
                  </li>
              {%- endfor -%}
            </span>
          </ul>

        </ul>
      {%- endif -%}
    {%- endif -%}

    <div class="grid grid--uniform blog-list-block">
      {%- for article in blog.articles -%}
        <div class="grid__item {{ grid_item_width }}">
          {%- render 'article-grid-item',
            article: article,
            image_size: section.settings.blog_image_size,
            show_excerpt: section.settings.blog_show_excerpt,
            show_author: section.settings.blog_show_author,
            show_date: section.settings.blog_show_date,
            show_comments: section.settings.blog_show_comments,
            show_tags: section.settings.blog_show_tags,
            sizeVariable: sizeVariable,
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
</div>

{% endpaginate %}

{% schema %}
{
  "name": "t:sections.blog-template.name",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.blog-template.settings.layout.label",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.blog-template.settings.layout.options.grid.label"
        },
        {
          "value": "feed",
          "label": "t:sections.blog-template.settings.layout.options.feed.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "t:sections.blog-template.settings.post_limit.label",
      "default": 9,
      "min": 3,
      "max": 18,
      "step": 3
    },
    {
      "type": "checkbox",
      "id": "blog_show_tag_filter",
      "label": "t:sections.blog-template.settings.blog_show_tag_filter.label"
    },
    {
      "type": "checkbox",
      "id": "blog_show_rss",
      "label": "t:sections.blog-template.settings.blog_show_rss.label"
    },
    {
      "type": "checkbox",
      "id": "blog_show_tags",
      "label": "t:sections.blog-template.settings.blog_show_tags.label"
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "t:sections.blog-template.settings.blog_show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_comments",
      "label": "t:sections.blog-template.settings.blog_show_comments.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "t:sections.blog-template.settings.blog_show_author.label"
    },
    {
      "type": "checkbox",
      "id": "blog_show_excerpt",
      "label": "t:sections.blog-template.settings.blog_show_excerpt.label"
    },
    {
      "type": "select",
      "id": "blog_image_size",
      "label": "t:sections.blog-template.settings.blog_image_size.label",
      "default": "wide",
      "options": [
        {
          "value": "natural",
          "label": "t:sections.blog-template.settings.blog_image_size.options.natural.label"
        },
        {
          "value": "square",
          "label": "t:sections.blog-template.settings.blog_image_size.options.square.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.blog-template.settings.blog_image_size.options.landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.blog-template.settings.blog_image_size.options.portrait.label"
        },
        {
          "value": "wide",
          "label": "t:sections.blog-template.settings.blog_image_size.options.wide.label"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "trending-blog",
      "name": "Trending Blogs",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Blog posts"
        },
        {
          "id": "blog",
          "type": "blog",
          "label": "Blog"
        },
        {
          "type": "range",
          "id": "post_limit",
          "label": "t:sections.blog-posts.settings.post_limit.label",
          "default": 3,
          "min": 2,
          "max": 4,
          "step": 1
        }
      ]
    },
    {
      "type": "popular-blog",
      "name": "Popular Blogs",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Blog posts"
        },
        {
          "id": "blog",
          "type": "blog",
          "label": "Blog"
        },
        {
          "type": "range",
          "id": "post_limit",
          "label": "t:sections.blog-posts.settings.post_limit.label",
          "default": 3,
          "min": 2,
          "max": 4,
          "step": 1
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}

<script>
  function showMoreTags() {
    document.getElementById("more-tags").style.display = "inline";
    document.querySelector(".load-more-btn").style.display = "none";
  }
</script>