<script>
$(document).ready(function () {
    const menuLinks = $(".product-info-top-tab-block ul li a");
    const sections = $(".section");

    menuLinks.on("click", function (event) {
        event.preventDefault();
        
        // Remove active class from all links
        menuLinks.removeClass("active");

        // Add active class to clicked link
        $(this).addClass("active");

        // Scroll smoothly to the section
        const section = $($(this).attr("href"));
        $('html, body').animate({
            scrollTop: section.offset().top - 50 // Adjust for fixed menu
        }, 500);
    });

    // Detect scroll and update active menu item & content block
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                
                // Remove active class from all links and sections
                menuLinks.removeClass("active");
                sections.removeClass("active");
                
                // Add active class to the visible section and its corresponding menu link
                $(entry.target).addClass("active");
                $(".product-info-top-tab-block ul li a[href='#" + id + "']").addClass("active");
            }
        });
    }, { rootMargin: "-50% 0px -50% 0px", threshold: 0.1 });

    sections.each(function () {
        observer.observe(this);
    });

    
    $('.gird_image_wrapper').slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      dots: false,
      centerPadding: '20px',
      arrows: true,
      infinite: true,
      swipeToSlide: true,
      centerMode: true,
      focusOnSelect: true,
      autoplay: true,
      autoplaySpeed: 2000,
      prevArrow: '<button class="slick-prev"><img src="https://cdn.shopify.com/s/files/1/2745/9950/files/slider_arrow.svg?v=1744048040" alt="Previous" /></button>',
      nextArrow: '<button class="slick-next"><img src="https://cdn.shopify.com/s/files/1/2745/9950/files/slider_arrow.svg?v=1744048040" alt="Next" /></button>',
    });

    $('.closer-look-block-grid').slick({
      slidesToShow: 3,
      slidesToScroll: 1,
      dots: false,
      centerPadding: '20px',
      arrows: true,
      infinite: true,
      swipeToSlide: true,
      centerMode: true,
      focusOnSelect: true,
      autoplay: true,
      autoplaySpeed: 2000,
      prevArrow: '<button class="slick-prev"><img src="https://cdn.shopify.com/s/files/1/2745/9950/files/slider_arrow.svg?v=1744048040" alt="Previous" /></button>',
      nextArrow: '<button class="slick-next"><img src="https://cdn.shopify.com/s/files/1/2745/9950/files/slider_arrow.svg?v=1744048040" alt="Next" /></button>',
      responsive: [{
      breakpoint: 1399,
        settings: {
          slidesToShow: 3
        }
        }, {
        breakpoint: 520,
        settings: {
          slidesToShow: 1
        }
      }]
    });

});

</script>

<script>
(function () {
  const section = document.getElementsByClassName('product-section');
  if (!section) return;

  const productSection = document.getElementsByClassName('top-sticky-block');
  if (!productSection) return;

  const variants = {{ product.variants | json }};
  const optionNames = {{ product.options | json }};
  const productDiscount = {{ product.metafields.custom.discount_percentage | default: 0 | plus: 0 }};
  const isRestoreGel = {{ product.handle | json }} === 'restore-gel';

  const variantDiscounts = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {{ variant.metafields.custom.discount_percentage | default: 0 | plus: 0 }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  function formatPrice(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(cents, Shopify.money_format);
    }
    return (cents / 100).toFixed(2);
  }

  function getSelectedVariant() {
    // Collect checked radios / selects for each option (search the whole section, not just the form)
    const selected = optionNames.map(function (name) {
      const radio = section.querySelector('input[type="radio"][name="' + name + '"]:checked');
      if (radio) return radio.value;
      const select = section.querySelector('select[name="' + name + '"]');
      return select ? select.value : null;
    });

    if (selected.every(Boolean)) {
      const match = variants.find(function (v) {
        return v.options.every(function (opt, i) { return opt === selected[i]; });
      });
      if (match) return match;
    }

    // Fallback: variant ID from URL or the form's id field
    const urlId = new URLSearchParams(window.location.search).get('variant');
    const idInput = section.querySelector('[name="id"]');
    const id = urlId || (idInput && idInput.value);
    return variants.find(function (v) { return String(v.id) === String(id); });
  }

  function updateVariantPrice() {
    debugger
    const variant = getSelectedVariant();
    if (!variant) return;

    const variantDiscount = Number(variantDiscounts[String(variant.id)] || 0);
    const discount = variantDiscount > 0 ? variantDiscount : productDiscount;
    const hasDiscount = discount > 0 && !isRestoreGel;
    const discountedPrice = hasDiscount
      ? Math.round(variant.price * (1 - discount / 100))
      : variant.price;

    const priceContainer = productSection.querySelector('.product-single__prices');
    if (!priceContainer) return;

    priceContainer.querySelectorAll('.product__price').forEach(function (el) {
      el.textContent = theme.Currency.formatMoney(discountedPrice);
    });

    priceContainer.querySelectorAll('.atc_variant_price').forEach(function (el) {
      if (hasDiscount) {
        el.textContent = theme.Currency.formatMoney(variant.price);
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });

    const label = section.querySelector('.dynamic-discount-label');
    if (label) {
      label.textContent = discount + '% OFF';
      label.style.display = discount > 0 ? 'inline-block' : 'none';
    }

    const btn =
      productSection.querySelector('button[name="add"]');

    if (btn) {
      btn.disabled = !variant.available;

      const text = theme.Currency.formatMoney(discountedPrice);

      // Prefer a dedicated text element so icons/spinners inside the button survive
      const textEl =
        btn.querySelector('.atc_variant_price');

      if (textEl) {
        textEl.textContent = text;
      } else {
        btn.textContent = text;
      }
    }
  }

  // Listen on the whole section so events from inputs outside the <form> are caught
  section.addEventListener('change', function (e) {
    if (e.target.matches('select, input[type="radio"], input[name="id"]')) {
      setTimeout(updateVariantPrice, 100);
    }
  });

  window.addEventListener('popstate', function () { setTimeout(updateVariantPrice, 100); });
  updateVariantPrice();
})();
</script>