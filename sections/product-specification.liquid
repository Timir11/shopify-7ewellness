{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

 <!-- product description tab for desktop -->
 <div class="product-specification-section">
  <div class="product-info-tab desktop-only">
    <div id="tabs">
      <div class="product-info-top-tab-block">
        <ul class="page-width">
          {% for block in section.blocks %}
            {% case block.type %}
              {%- when '@app' -%}
                <li><a href="#tabs-{{ forloop.index }}"></a></li>
              {% when 'result' %}
              <li><a href="#tabs-{{ forloop.index }}">{{ block.settings.tab_heading }}</a></li>
              {% when 'mobile-application' %}
                <li><a href="#tabs-{{ forloop.index }}">{{ block.settings.tab_heading }}</a></li>
              {%- when 'treatment' -%}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>
              {%- when 'faq' -%}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>
              {%- when 'how-to-use' -%}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>
              {% when 'video' %}
                <li><a href="#tabs-{{ forloop.index }}">{{ block.settings.tab_heading }}</a></li>
              {% when 'closer-look' %}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>              
              {% when 'benefits' %}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>              
              {% when 'technology' %}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>              
              {% when 'image-banner' %}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>              
              {% when 'ingredients' %}
                <li><a href='#tabs-{{ forloop.index }}'>{{ block.settings.tab_heading }}</a></li>              
            {% endcase %}
          {% endfor %}
              <li><a href='#tab-review'>Reviews</a></li>              
        </ul>
      </div>

      <div class="page-width  product-specification-content-block-wrapper">
        <div class="results-block">
          {% for block in section.blocks %}
            <div id="tabs-{{ forloop.index }}" class="product-specification-tabs">
              {% case block.type %}
                {%- when '@app' -%}
                  <div class="app-block">
                  {% render block %}
                  </div>
                {% when 'result' %}
                  {% liquid
                    assign per_row_desktop = block.settings.per_row_desktop
                    assign per_row_mobile = block.settings.per_row_mobile
    
                    case per_row_desktop
                      when 1
                      assign grid_large_width = 'result-col-1'
                      when 2
                        assign grid_large_width = 'result-col-2'
                      when 3
                        assign grid_large_width = 'result-col-3'
                      when 4
                        assign grid_large_width = 'result-col-4'
                    endcase
    
                    if per_row_mobile contains '2'
                      assign per_row_mobile = 2
                      assign grid_small_width = 'mobile-col-2'
                    endif
    
                    if per_row_mobile contains '1'
                      assign per_row_mobile = 1
                      assign grid_small_width = 'mobile-col-1'
                    endif
                  %}
                  <div class="grid product-info-results">
                   {%- if block.settings.title -%}
                      <h2 class="section_heading">{{ block.settings.title }}</h2>
                    {%- endif -%}
                    
                    <div class="grid__item">
                      <div class="gird_image_wrapper">
                        {%- for i in (1..8) -%}
                          {%- capture result_image -%}result_image{{i}}{%- endcapture -%}
                          {%- capture mobile_result_image -%}mobile_result_image{{i}}{%- endcapture -%}
                          {%- if block.settings[result_image] != blank and block.settings[mobile_result_image] != blank -%}
                            {% comment %} <img src="{{ block.settings[result_image] | image_url }}" alt="result image {{i}}" class="single-img" /> {% endcomment %}
                            <picture>
                              <source media="(max-width: 600px)" srcset="{{ block.settings[mobile_result_image] | image_url }}">
                              <img src="{{ block.settings[result_image] | image_url }}" alt="result image {{i}}" class="single-img">
                            </picture>

                          {%- endif -%}
                        {%- endfor -%}
                      </div>
    
                      {% comment %} {%- if block.settings.first_image1 and block.settings.second_image1 -%}
                        <div class="comparison-container">
                          <image-compare class="comparison comparison-{{ section.id }} comparison--style-classic" data-section-id="{{ section.id }}">
                            <div class="comparison__draggable" data-draggable style="width=150px;">
                              <div class="comparison__image-wrapper" data-primary-image style="width=150px;">
                                {%- render 'image-element',
                                  img: block.settings.first_image1,
                                  img_width: 2000,
                                  loading: true,
                                  classes:  comparison__image comparison__image--1,
                                -%}
                              </div>
                            </div>
                            <div class="comparison__image-wrapper" data-secondary-image>
                              {%- render 'image-element',
                                img: block.settings.second_image1,
                                img_width: 2000,
                                loading: true,
                                classes:  comparison__image comparison__image--2,
                              -%}
                            </div>
                            <button class="comparison__button" data-button>
                              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-left" viewBox="0 0 284.49 498.98"><title>icon-chevron-left</title><path d="M249.49 0a35 35 0 0 1 24.75 59.75L84.49 249.49l189.75 189.74a35.002 35.002 0 1 1-49.5 49.5L10.25 274.24a35 35 0 0 1 0-49.5L224.74 10.25A34.89 34.89 0 0 1 249.49 0Z"/></svg>
                              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-right" viewBox="0 0 284.49 498.98"><title>icon-chevron</title><path d="M35 498.98a35 35 0 0 1-24.75-59.75l189.74-189.74L10.25 59.75a35.002 35.002 0 0 1 49.5-49.5l214.49 214.49a35 35 0 0 1 0 49.5L59.75 488.73A34.89 34.89 0 0 1 35 498.98Z"/></svg>
                            </button>
                          </image-compare>
                        </div>
                      {%- endif -%} {% endcomment %}
                      
                      <div class="grid digits-results {{ grid_small_width }} {{ grid_large_width }}">
                        {%- for i in (1..4) -%}
    
                          {%- capture text -%}text{{i}}{%- endcapture -%}
                          {%- capture content -%}content{{i}}{%- endcapture -%}
                          {%- if block.settings[text] != blank or block.settings[content] != blank -%}
                            <div class="grid__item">
                                <h2 class="h2">{{ block.settings[text] }}</h2>
                                {% if block.settings[content] %}
                                  <p>{{ block.settings[content] }}</p>                              
                                {% endif %}
                            </div>                
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {% when 'mobile-application' %}
                  <div class="grid">
                    {%- liquid
                      assign image_width = block.settings.image_width
                      assign overlap_images = true
                      if block.settings.image == blank
                        assign overlap_images = false
                        assign placeholder_images = true
                      endif
                    -%}
                    <div class="page-width QT-application-block feature-row-wrapper feature-row--{{ image_width }}">
                      {%- capture image_layout -%}
                        <div class="feature-row__item feature-row__images{% if overlap_images %} feature-row__item--overlap-images{% endif %} {% if placeholder_images %}feature-row__item--placeholder-images{% endif %}" data-aos>
                          {% if block.settings.video_url != blank %}
                            {%- if block.settings.video_url.type == "youtube" -%}
                              <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0&showinfo=0&vq=720" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                            {%- endif -%}
                            {%- if block.settings.video_url.type == "vimeo" -%}
                              <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?color={{ settings.color_button | remove: "#" }}&byline=0&portrait=0&badge=0" width="850" height="480" frameborder="0" allowfullscreen></iframe>
                            {%- endif -%}
                          {% else %}
                            {%- if block.settings.image != blank -%}
                              <div class="feature-row__first-image">
                                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}<a href="{{ block.settings.button_link }}">{%- endif -%}
                                  <div class="image-wrap" style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;">
                                    {%- liquid
                                      assign sizeVariable = 'calc(0.4 * 50vw)'
                                      assign fallback = '40vw'
    
                                      assign imageWidth = block.settings.image_width | times: 1
                                      if imageWidth >= 50
                                        assign loading = block.settings.lazyload_images
                                      else
                                        assign loading = true
                                      endif
                                    -%}
                                    {%- render 'image-element',
                                      img: block.settings.image,
                                      widths: '180, 360, 540, 750, 900, 1080',
                                      loading: loading,
                                      sizeVariable: sizeVariable,
                                      fallback: fallback,
                                      classes: 'feature-row__image',
                                    -%}
                                  </div>
                                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}</a>{%- endif -%}
                              </div>
                            {%- endif -%}
    
                            {%- if block.settings.image == blank -%}
                              <div class="placeholder-image-wrap">
                                <div class="image-wrap">
                                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                </div>
                              </div>
                            {%- endif -%}
                        {%- endif -%}  
                        </div>
                      {%- endcapture -%}
    
                      <div class="feature-row qt-mobile-app-content {{ block.settings.custom_class }}" style="background-color: {{ block.settings.bg_color }}; border-color: {{ block.settings.border_color}};">
                        {%- if block.settings.layout == 'left' -%}
                          {{ image_layout }}
                        {%- endif -%}
    
                        <div class="feature-row__item feature-row__text feature-row__text--{{ block.settings.layout }} text-{{ block.settings.align_text }}" data-aos>
                          {%- if block.settings.subtitle != blank -%}
                            <div class="subheading appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ block.settings.subtitle }}</div>
                          {%- endif -%}
                          {%- if block.settings.title != blank -%}
                            <h2 class="h1 appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ block.settings.title | escape }}</h2>
                          {%- endif -%}
                          {%- if block.settings.text != blank -%}
                            <div class="rte appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ block.settings.text }}</div>
                          {%- endif -%}
    
                          {%- if block.settings.button_label != blank -%}
                            <div class="appear-delay{% cycle '','-1','-2','-3','-4' %}">
                              <a href="{{ block.settings.button_link }}" class="btn{% if block.settings.button_style == 'secondary' %} btn--tertiary{% endif %}">
                                {{ block.settings.button_label }}
                              </a>
                            </div>
                          {%- endif -%}
                        </div>
    
                        {%- if block.settings.layout == 'right' -%}
                          {{ image_layout }}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- when 'treatment' -%}
                  <div class="treatments_wrapper grid">
                    {%- if block.settings.title -%}
                      <h2 class="section_heading">{{ block.settings.title }}</h2>
                    {%- endif -%}
    
                    <div class="tab-container">
                      <!-- Left Step Navigation -->
                      <div class="tab-menu">
                        {%- for i in (1..5) -%}
                          {%- capture step_title -%}step_title{{i}}{%- endcapture -%}
                          {%- if step_title != blank -%}
                            <button class="tab-button {% if i == 1 %}active {% endif %}" data-tab="step{{i}}"><span>{{i}}</span> <span class="step_title">{{ block.settings[step_title] }}</span></button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
    
                      <!-- Right Content Section -->
                      <div class="tab-content">
                        {%- for i in (1..5) -%}
                          {%- capture step_image -%}step_image{{i}}{%- endcapture -%}
                          {%- capture step_content -%}step_content{{i}}{%- endcapture -%}
                          {%- if step_image != blank and step_content != blank -%}
                            <div id="step{{i}}" class="tab-pane {% if i == 1 %}active {% endif %}">
                              <div class="step-content-block">
                                <img class="step_image" src="{{  block.settings[step_image] |  image_url }}" alt="Step {{i}} Image" width="250" height="350">
                                <div class="step_content">{{  block.settings[step_content] }}</div>
                              </div>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- when 'faq' -%}
                  <div class="grid faq-section-wrapper">
                    {%- if block.settings.heading -%}
                      <h2 class="section_heading">{{ block.settings.heading }}</h2>
                    {%- endif -%}
                    {%- for i in (1..7) -%}
                      {%- capture faq_title -%}title{{i}}{%- endcapture -%}
                      {%- capture faq_text -%}text{{i}}{%- endcapture -%}
                      {% if block.settings[faq_title] != blank and block.settings[faq_text] != blank %}
                        <div class="faq_section">
                          <button type="button" class="collapsible-trigger collapsible-trigger--inline collapsible--auto-height text-left" aria-controls="FAQ-content-{{ block.id }}-{{ i }}">
                            <span>{{ block.settings[faq_title] }}</span>
                            {%- render 'collapsible-icons-alt', no_circle: true -%}
                          </button>
                          <div id="FAQ-content-{{ block.id }}-{{ i }}" class="collapsible-content collapsible-content--all">
                            <div class="collapsible-content__inner collapsible-content__inner--faq rte">
                              {{ block.settings[faq_text] }}
                            </div>
                          </div>
                        </div>                    
                      {% endif %}
                    {%- endfor -%}
                  </div>
                {%- when 'how-to-use' -%}
                  <div class="custom-content how-to-use-block-wrapper">
                    {% if block.settings.heading %}
                      <h2>{{ block.settings.heading }}</h2>                  
                    {% endif %}
                    {%- if block.settings.section_content -%}
                      <div class="section_content">{{ block.settings.section_content }}</div>
                    {%- endif -%}
                    <div class="how-to-use-block custom__item one-whole align--center">
                      <div class="custom__item-inner custom__item-inner--image">
                        <div class="aos-animate">
                          {%- if block.settings.link != blank -%}
                            <a href="{{ block.settings.link }}">
                          {%- endif -%}                              
                          {% if block.settings.image != blank or block.settings.mobile_image != blank %}
                            <picture>
                              <source media="(max-width: 600px)" srcset="{{ block.settings.mobile_image | image_url }}">
                              <img src="{{ block.settings.image | image_url }}" alt="block.settings.heading" class="how-to-use-image">
                            </picture>
                          {% endif %}
                          {%- if block.settings.link != blank -%}
                            </a>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                {% when 'video' %}
                  {% if block.settings.heading %}
                      <h2>{{ block.settings.heading }}</h2>                  
                  {% endif %}                  
                  {% if block.settings.video_url != blank %}
                    {% assign youtube_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
                    <div class="responsive-video-wrapper">
                      <iframe
                        src="https://www.youtube.com/embed/{{ youtube_id }}"
                        frameborder="0"
                        allowfullscreen
                        class="responsive-video-iframe"
                      ></iframe>
                    </div>
                  {% endif %}
                {%- when 'closer-look' -%}
                  <div class="closer-look-wrapper">
                    {%- if block.settings.heading -%}
                      <h2 class="section_heading">{{ block.settings.heading }}</h2>
                    {%- endif -%}
    
                    <div class="grid closer-look-block-grid"> 
                      {%- for i in (1..10) -%}
    
                        {%- capture look_image -%}look_image{{i}}{%- endcapture -%}
                        {%- capture block_heading -%}block_heading{{i}}{%- endcapture -%}
                        {%- capture block_content -%}block_content{{i}}{%- endcapture -%}
    
                          
                        {%- if block.settings[look_image] != blank or block.settings[block_heading] != blank or block.settings[block_content] != blank -%}      
                          <div class="grid__item medium-up--one-third one-whole">
                            <div class="image-box" onclick="toggleOverlay({{ forloop.index0 }})">
                              <img class="closer_look_image" src="{{  block.settings[look_image] |  image_url }}" alt="Step {{i}} Image" width="250" height="350">
                              <div class="default-text">{{ block.settings[block_heading] }}</div>
                              <div class="overlay">
                                <h4 class="overlay_heading">{{ block.settings[block_heading] }}</h4>
                                <div class="overlay_text">
                                  {{ block.settings[block_content] }}
                                </div>
                                <!-- <button class="close-btn" onclick="hideOverlay(event, {{ forloop.index0 }})">×</button> -->
                              </div>
                              <div class="plus-icon" onclick="toggleOverlay({{ forloop.index0 }})">
                                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38" fill="none">
                                  <circle cx="19.1157" cy="18.8843" r="17.644" stroke="white" stroke-width="1.37486"/>
                                  <path d="M11.7831 18.5172L27.1815 18.5172" stroke="white" stroke-width="1.37486" stroke-linecap="round"/>
                                  <path d="M19.4815 10.8185L19.4815 26.2169" stroke="white" stroke-width="1.37486" stroke-linecap="round"/>
                                </svg>
                              </div>
                            </div>            
                          </div>
                        {%- endif -%}
    
                      {%- endfor -%}
                    </div>
                  </div>
                {%- when 'benefits' -%}
                  <div class="benefits_wrapper" style="background-color: {{ block.settings.bg_color }}; border-color: {{ block.settings.border_color}};">
                    {%- if block.settings.heading -%}
                      <h2 class="section_heading">{{ block.settings.heading }}</h2>
                    {%- endif -%}
                    <div class="grid">
    
                      {%- for i in (1..6) -%}
    
                        {%- capture benefits_image -%}benefits_image{{i}}{%- endcapture -%}
                        {%- capture benefits_heading -%}benefits_heading{{i}}{%- endcapture -%}
                        {%- capture benefits_content -%}benefits_content{{i}}{%- endcapture -%}
    
                        {%- if block.settings[benefits_image] != blank or block.settings[benefits_heading] != blank or block.settings[benefits_content] != blank -%}  
                          <div class="grid__item medium-up--one-half one-whole benefits_block">
                            <img class="benefit-icon" src="{{  block.settings[benefits_image] |  image_url }}" alt="Benefits {{i}} Image" width="42" height="42">
                            <div class="benefit-text">
                                <h3 class="benefit-heading">{{ block.settings[benefits_heading] }}</h3>
                                <div class="benefit-contet">{{ block.settings[benefits_content] }}</div>
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
    
                    </div>
                  </div>
                {%- when 'technology' -%}
                  {%- if block.settings.heading -%}
                      <h2 class="section_heading">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                                  
                  <div class="technology_wrapper grid">                
                    <div class="image-container">
                      {% if block.settings.technology_image != blank %}
                        <img src="{{ block.settings.technology_image |  image_url }}" alt="Technology Image">
                      {% endif %}
                      
                      {%- for i in (1..5) -%}
                        {%- capture step_title -%}step_title{{i}}{%- endcapture -%}
    
                        {%- if block.settings[step_title] != blank -%}
                          <div class="marker {% if i == 1 %}active {% endif %}" data-id="{{i}}" onclick="showFeature({{i}})">{{i}}</div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
    
                    <div class="text-content">
                                        
                      {%- for i in (1..5) -%}
                        {%- capture step_title -%}step_title{{i}}{%- endcapture -%}
                        {%- capture step_content -%}step_content{{i}}{%- endcapture -%}
    
                        {%- if block.settings[step_title] != blank and block.settings[step_content] != blank -%}
    
                          <div class="techno_description {% if i == 1 %}active {% endif %}" id="desc-{{i}}">
                              <h4 class="techno_step_title">{{ block.settings[step_title] }}</h4>
                              <p>{{ block.settings[step_content] }}</p>
                          </div>
                          
                        {%- endif -%}
                      {%- endfor -%}
    
                        <div class="sidebar-markers">
                        
                        {%- for i in (1..5) -%}
                          {%- capture step_title -%}step_title{{i}}{%- endcapture -%}
    
                          {%- if block.settings[step_title] != blank -%}
                            <div class="sidebar-marker {% if i == 1 %}active {% endif %}" data-id="{{i}}" onclick="showFeature({{i}})">{{i}}</div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                                  
                  </div>
                {%- when 'image-banner' -%}
                  <div class="serum-image-banner" style="background: url({{ block.settings.image_banner | image_url }}) no-repeat 0 0;">
                    <div class="serum-image-wrapper">
                      {% if block.settings.image_banner != blank and block.settings.mobile_image_banner != blank %}
                        <picture>
                          <source media="(max-width: 600px)" srcset="{{ block.settings.mobile_image_banner | image_url }}">
                          <img src="{{ block.settings.image_banner | image_url }}" alt="block.settings.heading" class="serum-image">
                        </picture>
                      {% endif %}
                      <div class="serum-text-overlay">
                        {%- if block.settings.heading -%}
                          <h2 class="section_heading">{{ block.settings.heading }}</h2>
                        {%- endif -%}
                        {% if block.settings.image_content != blank %}
                          <div>{{ block.settings.image_content }}</div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- when 'ingredients' -%}
                  <div class="ingredients-section">
                    <div class="ingredients-wrapper">
                      {%- if block.settings.heading -%}
                        <h2 class="section_heading">{{ block.settings.heading }}</h2>
                      {%- endif -%}
                      <div class="grid ingredients-grid">
                        {%- for i in (1..5) -%}
                          {%- capture ingredient_img -%}ingredient_img{{i}}{%- endcapture -%}
                          {%- capture ingredients_text -%}ingredients_text{{i}}{%- endcapture -%}
                          {%- if block.settings[ingredient_img] != blank and block.settings[ingredients_text] != blank  -%}
                            <div class="grid__item medium-up--one-quarter one-half">
                              <img src="{{ block.settings[ingredient_img] |  image_url }}" alt="{{ block.settings[ingredients_text] }}">
                              <p>{{ block.settings[ingredients_text] }}</p>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>

              {% endcase %}

            </div>
          {% endfor %}
        </div>

        <div class="medium-up--one-third top-sticky-block small--hide">
          <div class="card">
            {% capture form_id %}AddToCartForm-{{ product.id }}{% endcapture %}
            <img src="{{ product.featured_image | image_url }}" alt="{{ product.title }}" width="390" height="300">
            <div class="card-body">
              <div class="title">{{ product.title }}</div>
              <div class="rating">
                {% render 'okendo-reviews-product-rating-summary', product: product %}
              </div>
              <div class="price">
                <div class="product-single__prices">
                  {%- if product.compare_at_price_max > product.price -%}
                    {%- liquid
                      assign hide_sale_price = true
                      if current_variant.compare_at_price > current_variant.price
                        assign hide_sale_price = false
                      endif
                    -%}
                    <span
                      class="visually-hidden"
                      aria-hidden="{{ hide_sale_price }}"
                      data-price-a11y>
                        {{ 'products.general.regular_price' | t }}
                    </span>
                    <span class="{% if hide_sale_price %} hide{% endif %}" data-price-wrapper>
                      <span class="product__price product__price--compare" data-product-price-compare>
                        {%- if current_variant.compare_at_price > current_variant.price -%}
                          {{ current_variant.compare_at_price | money }}
                        {%- endif -%}
                      </span>
                    </span>
                    <span class="visually-hidden" data-compare-a11y>{{ 'products.general.sale_price' | t }}</span>
                  {%- else -%}
                    <span class="visually-hidden" data-price-a11y>{{ 'products.general.regular_price' | t }}</span>
                  {%- endif -%}

                  <span
                    class="product__price{% if current_variant.compare_at_price > current_variant.price %} sale-price{% endif %}"
                    data-product-price>
                    {%- unless product.empty? -%}
                      {{ current_variant.price | money }}
                    {%- else -%}
                      {{ 1999 | money }}
                    {%- endunless -%}
                  </span>
                </div>
              </div>
              <div class="button">
                {%- unless product.empty? -%}
                  <div class="product-block">
                    {%- render 'product-specification-form',
                      form_id: form_id,
                      section_id: product.id,
                      product: product,
                      show_dynamic_checkout: block.settings.show_dynamic_checkout,
                      current_variant: current_variant,
                      block: block,
                    -%}
                  </div>
                {%- endunless -%}
              </div>
            </div>
          </div>
        </div>
      </div>


    </div>
  </div>
      <div class="page-width review-section">
        <div id="tab-review" class="review-section">
          {% comment %} {% render 'okendo-reviews-widget', product: product %} {% endcomment %}
          <h2 id="oke-reviews-widget-header">What our Customers are saying...</h2>
          {% render 'okendo-reviews-widget', product: product %}
        </div>
      </div>                                        
 </div>

