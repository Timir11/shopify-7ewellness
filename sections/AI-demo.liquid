{% comment %} <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script> {% endcomment %}
<script>
  // The CID is unique to the module. When business is confirmed, you will receive your unique CID.
  const cid = "c47038";
  // The API key is unique to the module and account. When business is confirmed, you will receive your unique API key.
  const apiKey = "u9Yzqi5tVVlVaR460ytdg";
  // The source domain will either be plugins-media.makeupar.com or plugins-media.perfectcorp.com depending on the account.
  const sourceDomain = "https://plugins-media.makeupar.com/";

  // IMPORTANT: The module should only be loaded ONCE for the entire user experience.
  // You may encounter errors and hangs if the module is duplicated in memory.
  // Please use YMK.init() and other methods [below] to open the module.

  // Module script START
  (function (d, k) {
    var s = d.createElement("script");
    s.type = "text/javascript";
    s.async = true;
    s.src = sourceDomain + cid + "/sdk.js?apiKey=" + k;
    var x = d.getElementsByTagName("script")[0];
    x.parentNode.insertBefore(s, x);
  })(document, apiKey);
  // Module script END
</script>
