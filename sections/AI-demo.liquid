<script>
  // Please see the API documentation at the link below for details on how these methods work
  // https://drive.google.com/file/d/1iQs4qgNNpyfLQKgNvi84vSoykAeR26YF/view?usp=sharing
  // The window.ymkAsyncInit global function is required, as is also the YMK.init() method.
  //
  window.ymkAsyncInit = function () {
    YMK.openSkincare();
    YMK.init({
      // YMK.init initializes the module

      autoOpen: false, // if set to true, the module will open as soon as the script is loaded and initialized

      // language: "enu", // other languages may be set upon loading - customization of the strings is possible; please contact Perfect

      // width: 405, // changes the module size; range is 300 to 600 px
      // height: 540, // changes the module size; range is 300 to 800 px

      // privacyPolicyURL: "https://yourprivacypolicyURL/",
      // the words 'Privacy Policy' in the consent sceen can be set to link to the URL set here
      // IMPORTANT: The consent screen is geofenced by default.
      // The screen will show only for users accessing from the U.S. or China.
      // If you need the consent screen to show for users accessing from outisde U.S. or China, please contact your PERFECT project manager for details.

      // disableSkinAge: true, //default is false; if set to true, the module will not show the "Skin Age" results after the assessment
      // disableSkinHealth: true, //default is false; if set to true, the module will not show the "Skin Health" results after the assessment

      // hideSkinAnalysisResult: true,
      // Note: the default for 'hideSkinAnalysisResult' is false;
      //   if set to true, the module will not show the skin analysis results after the assessment

      skincareFeatures: [
        //"acne",
        "ageSpots",
        "wrinkles",
        "texture",
        "darkCirclesV2",
        "oiliness",
        "redness",
        "moisture",
        "droopyLowerEyelid",
        "droopyUpperEyelid",
        "eyeBags",
        "pore",
        "firmness",
        "radiance",
      ],
      // Note: the 'skincareFeatures' parameter can control the order and selection of the skincare concerns
    });

    YMK.addEventListener("opened", function () {
      // document.body.appendChild(
      //   document.createTextNode("opened event triggered")
      // );
      // document.body.appendChild(document.createElement("br"));
    });

    YMK.addEventListener("loaded", function () {
      // document.body.appendChild(
      //   document.createTextNode("loaded event triggered")
      // );
      // document.body.appendChild(document.createElement("br"));
    });

    YMK.addEventListener("skinAnalysisProgressUpdated", function (progress) {
      console.log("Skin Analysis Progess " + progress);

      // In this test script, the progress will be shown on the webpage under the 'skinAnalysisProgress' div
      document
        .getElementById("skinAnalysisProgress")
        .replaceChildren("Skin Analysis is " + progress + " % complete");
    });

    YMK.addEventListener("skinAnalysisUpdated", function (report) {
      console.log("report", report); // This is the JS object that is returned by the 'skinAnalysisUpdated' event.
      // to turn the JS object to a JSON, JSON.stringify() may be used
      // Print the value of the "name" property
      const result = JSON.stringify(report);
      const jsonObject = JSON.parse(result);
      console.log("skinage", jsonObject.skinHealth); // This is the JSON version of the report.
      const skinHealthScore = jsonObject.skinHealth;
      localStorage.setItem("Wrinkles", jsonObject.wrinkles);
      localStorage.setItem("Moisture", jsonObject.moisture);
      localStorage.setItem("Firmness", jsonObject.firmness);
      productRecommended(jsonObject.wrinkles, jsonObject.firmness, jsonObject.moisture);
    });

  };

  function productRecommended(w_score,f_score,m_score){
    debugger
    var minscore = Math.min(w_score,f_score,m_score);
    if(w_score == minscore){
      setTimeout(function(){
      document.getElementById("productID_wrinkles").style.display = 'block';
      },4000);
    }
    if(f_score == minscore){
      setTimeout(function(){
      document.getElementById("productID_firmness").style.display = 'block';
      },4000);
    }
    if(m_score == minscore){
      setTimeout(function(){
      document.getElementById("productID_moisture").style.display = 'block';
      },4000);
    }
  }
</script>
