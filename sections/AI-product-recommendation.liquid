<script>
    var getUrlParameter = function getUrlParameter(sParam) {
      //debugger;
      var sPageURL = window.location.search.substring(1),
          sURLVariables = sPageURL.split('&'),
          sParameterName,
          i;
      for (i = 0; i < sURLVariables.length; i++) {
          sParameterName = sURLVariables[i].split('=');

          if (sParameterName[0] === sParam) {
              return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
          }
      }
  };

  var id = getUrlParameter('id');
  var number = getUrlParameter('number');
  if (id === undefined) {
      id = "tabs-1"
      number = 1;
  }
  var wrinkle_score = localStorage.getItem('Wrinkles');
  console.log('wrinkles', wrinkle_score);
  var firmness_score = localStorage.getItem('Firmness');
  console.log('Firmness', firmness_score);
  var moisure_score = localStorage.getItem('Moisture');
  console.log('Moisture', moisure_score);
  $(document).ready(function () {
    $('.AI-prod-recom-tabs .nav-tabs li .nav-link').removeClass('active');
    $('#' + id).addClass('active');
    // $('#' + id).next('.Recommended').addClass('show');
    $('.AI-prod-recom-tabs .tab-pane').removeClass('active');
    $('#tabs-' + number).addClass('active');
    $('#wrinkle_score').text(wrinkle_score);
    $('#firmness_score').text(firmness_score);
    $('#moisture_score').text(moisure_score);
  });
</script>

