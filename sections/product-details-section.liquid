  /* display: flex; */
  /* flex-wrap: wrap; */
}
  .wrp_slide {
    display: flex;
}
  .carousel-controls {
    position: absolute;
    top: 50%;
    width: 69%;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
}
  .part_one {
    display: flex;
    flex-direction: column;
    align-items: center;
}
  .customer_images .flickity-button {    
    background: transparent;
  } 
  .container_flex {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
}

 

</style>
