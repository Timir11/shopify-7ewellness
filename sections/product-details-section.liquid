<!-- Flickity CSS -->
<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">

<!-- Flickity JS -->
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>



{% schema %}
{
  "name": "Product Details Section",
  "settings": [
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Featured Product 1"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Featured Product 2"
    },
    {
      "type": "product",
      "id": "featured_product_3",
      "label": "Featured Product 3"
    },
    {
      "type": "product",
      "id": "featured_product_4",
      "label": "Featured Product 4"
    },
    {
      "type": "product",
      "id": "featured_product_5",
      "label": "Featured Product 5"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Heading"
        },
        {
          "type": "image_picker",
          "id": "circular_image",
          "label": "Circular Image"
        },
        {
          "type": "range",
          "id": "percentage",
          "label": "Percentage",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "type": "textarea",
          "id": "content_text",
          "label": "Text Content",
          "default": "Description or additional text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<div class="product-details-section">
  <div class="container">
    <!-- Content Block -->
    <div class="container_wrp">
      <div class="container_flex">
    <div class="part content">
      {% for block in section.blocks %}
        {% if block.type == 'content_block' %}
          <div class="part_one">
          <h2>{{ block.settings.heading }}</h2>
          {% if block.settings.circular_image %}
            <img src="{{ block.settings.circular_image | img_url: '150x150' }}" alt="Circular Image" class="circular-image">
          {% endif %}
          </div>
          <div class="part_two">
          <p>
            <span class="percentage-number">{{ block.settings.percentage }}</span>
            <span class="percentage-symbol">%</span>
          </p>
          <p>{{ block.settings.content_text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Featured Product Carousel -->
     <div class="featured-product">
      <div class="carousel-container">
        <div class="carousel-wrapper">
          <!-- Product Slides -->
          <div class="wrp_slide">
          <div class="carousel-slide" data-index="0">
            <img src="{{ all_products[section.settings.featured_product_1].featured_image | img_url: '400x400' }}" alt="Product 1">
          </div>
          <div class="carousel-slide" data-index="1">
            <img src="{{ all_products[section.settings.featured_product_2].featured_image | img_url: '400x400' }}" alt="Product 2">
          </div>
          <div class="carousel-slide" data-index="2">
            <img src="{{ all_products[section.settings.featured_product_3].featured_image | img_url: '400x400' }}" alt="Product 3">
          </div>
          <div class="carousel-slide" data-index="3">
            <img src="{{ all_products[section.settings.featured_product_4].featured_image | img_url: '400x400' }}" alt="Product 4">
          </div>
          <div class="carousel-slide" data-index="4">
            <img src="{{ all_products[section.settings.featured_product_5].featured_image | img_url: '400x400' }}" alt="Product 5">
          </div>
            </div>
        </div>

        <!-- Carousel Controls -->
        <div class="carousel-controls">
          <button class="prev-slide">Prev</button>
          <button class="next-slide">Next</button>
        </div>
      </div>

      <!-- Product Details Section (Dynamic Content) -->
      <div class="product-details">
        <h3 class="product-title" id="product-title">{{ all_products[section.settings.featured_product_1].title }}</h3>
        <p class="product-description" id="product-description">{{ all_products[section.settings.featured_product_1].description | strip_html | truncate: 150 }}</p>
        <p class="product-price" id="product-price">{{ all_products[section.settings.featured_product_1].price | money }}</p>
        {% assign product = all_products[section.settings.featured_product_1] %}
        {% assign current_variant = product.selected_or_first_available_variant %}
        {%- assign productID = product.id -%}
      {%- assign productID = 'AddToCartForm-' | append: productID -%}
      {%- form 'product', product, id: productID, class: 'product-single__form small--text-center' -%}
        <input type="hidden" name="data-product-id" value="{{ product.id }}">        
          <button
             {% if product.empty? %}
              type="button"
            {% else %}
              type="submit"
            {% endif %}
            name="add"
            data-add-to-cart
            class="coll_product_cart btn add-to-cart 123"
            {% unless current_variant.available %}
              disabled="disabled"
            {% endunless %}
            >
            <span data-add-to-cart-text="" data-default-text="Add to cart">
              Add to cart
            </span>
          </button>   
          <!-- <input type="hidden" value="{{ product.selected_or_first_available_variant.id }}" name="id">  -->
        <select
          name="id"
          id="ProductSelect-{{ product.id }}"
          class="product-single__variants no-js"
          data-product-select
        >
          {%- for variant in product.variants -%}
            {%- if variant.available -%}
              <option
                value="{{ variant.id }}"
                {%- if variant == product.selected_or_first_available_variant -%}
                  selected="selected"
                {%- endif -%}
              >
                {{ variant.title }} - {{ variant.price | money_with_currency }}
              </option>
            {%- else -%}
              <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
            {%- endif -%}
          {%- endfor -%}
        </select>
          <input type="hidden" value="1" name="quantity"> 
          {%- unless product.empty? -%}
          <textarea
            class="hide"
            aria-hidden="true"
            aria-label="Product JSON"
            data-variant-json
          >{{ product.variants | json }}</textarea>
          {%- if product.options.size > 1 -%}
            <textarea
              class="hide"
              aria-hidden="true"
              aria-label="Variant JSON"
              data-current-variant-json
            >{{ current_variant | json }}</textarea>
          {%- endif -%}
        {%- endunless -%}
        {% endform %}
      </div>
    </div> 



        
      </div>
      </div>
  </div>
</div>

