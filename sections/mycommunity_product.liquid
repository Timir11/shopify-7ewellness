  {
    "name": "mycommunity-product",
    "settings": [],
     "blocks":[
      {
        "name":"Product",
        "type":"Product",
        "limit": 5,
        "settings":[
          {
              "type":"product",
            "id":"product",
            "label":"Product"
          },
