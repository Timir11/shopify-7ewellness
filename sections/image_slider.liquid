<div class="slide_wrp bgimg">
  <div class="page-width">
  <div class="slide_title">
    <h2 class="section-header__title appear-delay">{{ section.settings.title }}</h2>  
  </div>
  <div class="image_wrp">
    <div class="image_slide">
      {% for block in section.blocks %}
        <div class="slide_image">
          <img src="{{ block.settings.image | img_url:'master' }}" alt="{{ block.settings.image.alt }}">
        </div>
      {% endfor %}
    </div>
  </div>
  </div>
  <div class="btn_wrp ">
    <a href="{{ section.settings.btn_url }}" class="btn btn--tertiary btn--small my_class2">
      <span class="link">{{ section.settings.btn_text }}</span>                                                  
    </a>
  </div>
</div>
<script>
  {% if template.suffix == 'free-myocommunity' %}
    $(document).ready(function(){
    $(".image_slide").slick({
       slidesToShow: 8,   
       slidesToScroll: 1,
       loop:true,
       infinite:true,
      autoplay:true,
       responsive: [
      {
          breakpoint: 1024,
          settings: {
            slidesToShow: 6,
            slidesToScroll: 1, 
            arrows:false,
            dots:false,
          }
        },
        {
          breakpoint: 765,
          settings: {
            slidesToShow: 4,
            slidesToScroll: 1, 
            arrows:false,
            dots:false,
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1,
            arrows:false,
            dots:false,
          }
        }
      ]
    });
  })
  {% else %}
    $(document).ready(function(){
      $(".image_slide").slick({
         slidesToShow: 5,   
         slidesToScroll: 1,
         responsive: [
          {
            breakpoint: 765,
            settings: {
              slidesToShow: 4,
              slidesToScroll: 1, 
              arrows:false,
              dots:false,
            }
          },
          {
            breakpoint: 600,
            settings: {
              slidesToShow: 3,
              slidesToScroll: 1,
              arrows:false,
              dots:false,
            }
          }
        ]
      });
    })
  {% endif %}
</script>
{% schema %}
  {
    "name": "Image Slider",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"      
      },
       {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text"      
      },
      {
        "type": "text",
        "id": "btn_url",
        "label": "Button URL"      
      }
    ],
      "blocks": [
    {
      "type": "imageslider",
      "name": "Image slider",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"      
        }
      ]
    }
    ],
    "presets": [{
      "name": "Image Slider"
    }]
  }
{% endschema %}



