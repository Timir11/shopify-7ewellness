  .bb-rev-grid{grid-template-columns:1fr 1fr}
  .bb-stats-in{grid-template-columns:1fr 1fr} .bb-stat{border-right:none;border-bottom:1px solid rgba(255,255,255,.1);padding:16px 0} .bb-stat:nth-child(1),.bb-stat:nth-child(2){border-right:1px solid rgba(255,255,255,.1)} .bb-stat:nth-child(3),.bb-stat:nth-child(4){border-bottom:none} .bb-stat-num{font-size:32px}
  .bb-offer-box{padding:44px 32px} .bb-offer-h{font-size:32px}
  .bb-final h2{font-size:32px} .bb-sec-hdr h2{font-size:28px}
}
@media(max-width:600px){
