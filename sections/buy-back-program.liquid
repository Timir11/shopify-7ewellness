{% comment %}
  7E Wellness — Buy Back Program
  Full Shopify 2.0 Section with Theme Editor settings
  File: sections/buy-back-program.liquid
{% endcomment %}

{{ 'https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap' | stylesheet_tag }}

<style>
.bb { --black:#111111; --bg:#F5F5F5; --border:#231F20; --border-light:#E0DDDA; --text:#1C1C1C; --text-2:#5A5652; --muted:#9A9490; --green:#4A7C5C; --red:#C0504A; --grad:linear-gradient(90deg,#E7DCA7 0%,#7B6830 100%); --pill:999px; --r-sm:6px; --r-md:10px; }
.bb * { box-sizing:border-box; margin:0; padding:0; }
.bb { font-family:'Inter',sans-serif; color:var(--text); font-size:14px; line-height:1.65; -webkit-font-smoothing:antialiased; overflow-x:hidden; }
.bb h1,.bb h2,.bb h3 { font-family:'Open Sans',sans-serif; font-weight:600; line-height:1.18; color:var(--text); }
.bb a { text-decoration:none; }

/* Reveal */
.bb .rv { opacity:0; transform:translateY(28px); transition:opacity .55s cubic-bezier(.22,1,.36,1),transform .55s cubic-bezier(.22,1,.36,1); }
.bb .rv.on { opacity:1; transform:translateY(0); }
.bb .d1{transition-delay:.08s} .bb .d2{transition-delay:.16s} .bb .d3{transition-delay:.24s} .bb .d4{transition-delay:.32s}

/* Buttons */
.bb .btn-b { display:inline-flex;align-items:center;gap:7px;background:var(--black);color:#fff;font-family:'Open Sans',sans-serif;font-size:13px;font-weight:600;padding:13px 28px;border-radius:var(--pill);border:none;cursor:pointer;text-decoration:none;transition:background .2s,transform .15s,box-shadow .2s;position:relative;overflow:hidden; }
.bb .btn-b:hover { background:#2e2e2e;transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.18); }
.bb .btn-o { display:inline-flex;align-items:center;gap:7px;background:transparent;color:var(--text);font-family:'Open Sans',sans-serif;font-size:13px;font-weight:600;padding:12px 26px;border-radius:var(--pill);border:1.5px solid var(--border);cursor:pointer;text-decoration:none;transition:background .2s,color .2s,transform .15s; }
.bb .btn-o:hover { background:var(--black);color:#fff;transform:translateY(-2px); }
.bb .eyebrow { display:inline-block;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--text-2);margin-bottom:10px; }
.bb .sec-hdr { text-align:center;max-width:560px;margin:0 auto 48px; }
.bb .sec-hdr h2 { font-size:32px;font-weight:600;letter-spacing:-.018em;margin-bottom:10px; }
.bb .sec-hdr p { font-size:15px;color:var(--text-2); }

/* S1 Announce */
.bb-announce { text-align:center;padding:11px 20px;font-family:'Inter',sans-serif;font-size:12px;font-weight:500;letter-spacing:.05em; }
.bb-announce strong { font-weight:700; }

/* S2 Hero */
.bb-hero { padding:76px 40px 84px;border-bottom:1px solid var(--border-light); }
.bb-hero-in { max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr 440px;gap:64px;align-items:center; }
.bb-prog-tag { display:inline-flex;align-items:center;background:#fff;border:1px solid var(--border);border-radius:var(--pill);padding:5px 14px;margin-bottom:22px;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-2); }
.bb-hero h1 { font-size:50px;font-weight:600;letter-spacing:-.025em;margin-bottom:18px; }
.bb-hero-sub { font-size:15px;color:var(--text-2);line-height:1.72;max-width:440px;margin-bottom:30px; }
.bb-price-row { display:flex;align-items:baseline;gap:14px;margin-bottom:34px;flex-wrap:wrap; }
.bb-p-was { font-size:18px;color:var(--muted);text-decoration:line-through; }
.bb-p-now { font-family:'Open Sans',sans-serif;font-size:52px;font-weight:700;color:var(--text);letter-spacing:-.03em;line-height:1; }
.bb-p-save { background:var(--red);color:#fff;font-family:'Inter',sans-serif;font-size:11px;font-weight:700;padding:4px 11px;border-radius:var(--pill);align-self:center; }
.bb-hero-ctas { display:flex;gap:12px;flex-wrap:wrap;align-items:center; }
.bb-hcard { background:#fff;border:1px solid var(--border);border-radius:var(--r-md);padding:28px;box-shadow:0 6px 20px rgba(0,0,0,.1);transition:transform .3s,box-shadow .3s; }
.bb-hcard:hover { transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.12); }
.bb-hcard-tag { font-family:'Inter',sans-serif;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:14px; }
.bb-hcard-img { border-radius:var(--r-sm);overflow:hidden;margin-bottom:20px; }
.bb-hcard-img img { width:100%;height:230px;object-fit:contain;display:block; }
.bb-hcard-img-placeholder { background:var(--bg);border:1.5px dashed var(--border-light);border-radius:var(--r-sm);height:230px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:12px;text-align:center;gap:8px;margin-bottom:20px; }
.bb-pills { display:flex;gap:8px;flex-wrap:wrap; }
.bb-pill { background:var(--bg);border:1px solid var(--border-light);border-radius:var(--pill);padding:6px 13px;font-family:'Inter',sans-serif;font-size:12px;font-weight:600;color:var(--text); }

/* S3 Trust — Marquee Slider */
.bb-trust { border-bottom:1px solid var(--border-light);border-top:1px solid var(--border-light);background:#fff;padding:0;overflow:hidden; }
.bb-trust-track-wrap { overflow:hidden;position:relative; }
.bb-trust-track-wrap::before,.bb-trust-track-wrap::after { content:'';position:absolute;top:0;bottom:0;width:60px;z-index:2;pointer-events:none; }
.bb-trust-track-wrap::before { left:0;background:linear-gradient(to right,#fff,transparent); }
.bb-trust-track-wrap::after { right:0;background:linear-gradient(to left,#fff,transparent); }
.bb-trust-track { display:flex;width:max-content;animation:bb-marquee 28s linear infinite; }
.bb-trust-track:hover { animation-play-state:paused; }
.bb-trust-set { display:flex;align-items:stretch; }
.bb-ti { display:flex;align-items:center;gap:12px;padding:14px 32px;border-right:1px solid var(--border-light);white-space:nowrap;flex-shrink:0; }
.bb-ti-icon { font-size:20px;flex-shrink:0; }
.bb-ti strong { display:block;font-family:'Open Sans',sans-serif;font-size:12px;font-weight:600;color:var(--text); }
.bb-ti span { font-size:11px;color:var(--muted); }
@keyframes bb-marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* S4 Eligibility */
.bb-elig { padding:76px 40px;background:#fff; }
.bb-elig-in { max-width:1120px;margin:0 auto; }
.bb-elig-grid { display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center; }
.bb-trade-pair { display:grid;grid-template-columns:1fr 1fr;gap:16px; }
.bb-trade-card { background:var(--bg);border:1px solid var(--border);border-radius:var(--r-md);padding:26px 22px;position:relative;transition:box-shadow .25s,transform .25s; }
.bb-trade-card:hover { box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-3px); }
.bb-trade-badge { position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--red);color:#fff;font-family:'Inter',sans-serif;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 11px;border-radius:var(--pill);white-space:nowrap;z-index:2; }
.bb-trade-card { padding-top:32px; }
.bb-trade-img { background:#fff;border:1px solid var(--border-light);border-radius:var(--r-sm);height:120px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;overflow:hidden; }
.bb-trade-img img { width:100%;height:100%;object-fit:contain; }
.bb-trade-img-placeholder { background:#fff;border:1px solid var(--border-light);border-radius:var(--r-sm);height:120px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px; }
.bb-trade-name { font-family:'Open Sans',sans-serif;font-size:16px;font-weight:600;margin-bottom:6px; }
.bb-trade-desc { font-size:12px;color:var(--text-2);line-height:1.55; }
.bb-trade-list { list-style:none;margin-top:14px;display:flex;flex-direction:column;gap:7px; }
.bb-trade-list li { font-size:12px;color:var(--text-2);display:flex;gap:8px;align-items:flex-start; }
.bb-trade-list li::before { content:'✓';color:var(--green);font-weight:700;flex-shrink:0; }
.bb-arrow { display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 8px; }
.bb-arrow-c { width:44px;height:44px;background:var(--black);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px; }
.bb-arrow-lbl { font-family:'Inter',sans-serif;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);text-align:center; }
.bb-dest-card { background:#fff;border:1px solid var(--border);border-radius:var(--r-md);padding:28px 24px;position:relative;transition:box-shadow .25s,transform .25s; }
.bb-dest-card:hover { box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-3px); }
.bb-dest-badge { position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:linear-gradient(90deg,#E7DCA7,#7B6830);color:var(--black);font-family:'Inter',sans-serif;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 11px;border-radius:var(--pill);white-space:nowrap; }
.bb-dest-img { border-radius:var(--r-sm);height:160px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;overflow:hidden;background:var(--bg);border:1px solid var(--border-light); }
.bb-dest-img img { width:100%;height:100%;object-fit:contain; }

/* S5 Steps */
.bb-how { padding:76px 40px;background:var(--bg);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light); }
.bb-how-in { max-width:1120px;margin:0 auto; }
.bb-steps { display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;margin-top:48px; }
.bb-steps::before { content:'';position:absolute;top:22px;left:10%;right:10%;height:2px;background:var(--border-light);z-index:0; }
.bb-step { display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 16px;position:relative;z-index:1; }
.bb-step-num { width:44px;height:44px;background:var(--black);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Open Sans',sans-serif;font-size:15px;font-weight:700;color:#fff;margin-bottom:18px;flex-shrink:0;transition:transform .25s; }
.bb-step:hover .bb-step-num { transform:scale(1.12); }
.bb-step-icon { font-size:26px;margin-bottom:12px; }
.bb-step-title { font-family:'Open Sans',sans-serif;font-size:15px;font-weight:600;margin-bottom:8px; }
.bb-step-desc { font-size:13px;color:var(--text-2);line-height:1.6; }

/* S6 Table */
.bb-compare { padding:76px 40px;background:#fff; }
.bb-compare-in { max-width:1120px;margin:0 auto; }
.bb-tbl-wrap { overflow-x:auto;-webkit-overflow-scrolling:touch; }
.bb-tbl { width:100%;border-collapse:collapse;margin-top:40px;border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden; }
.bb-tbl thead tr { background:var(--bg); }
.bb-tbl th { padding:16px 20px;text-align:left;font-family:'Open Sans',sans-serif;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2);border-bottom:1px solid var(--border); }
.bb-tbl th.tw { background:#f0ede8;color:var(--text); }
.bb-tbl td { padding:14px 20px;font-size:13px;border-bottom:1px solid var(--border-light);vertical-align:middle; }
.bb-tbl td.tw { background:#faf9f7;font-weight:500; }
.bb-tbl tbody tr:last-child td { border-bottom:none; }
.bb-tbl tbody tr:hover td { background:#fafafa; }
.bb-tbl tbody tr:hover td.tw { background:#f5f3f0; }
.bb-chk { color:#4A7C5C;font-weight:700; } .bb-x { color:#9A9490; }
.bb-up-pill { background:linear-gradient(90deg,#E7DCA7,#7B6830);color:#111;font-family:'Inter',sans-serif;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:999px;margin-left:6px; }

/* S7 Feature Cards */
.bb-features { padding:76px 40px;background:var(--bg); }
.bb-feat-in { max-width:1120px;margin:0 auto; }
.bb-feat-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px; }
/* Mobile slider */
.bb-feat-slider-wrap { display:none;position:relative;margin-top:48px; }
.bb-feat-slider { display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px; }
.bb-feat-slider::-webkit-scrollbar { display:none; }
.bb-feat-slider .bb-fc { flex:0 0 82vw;max-width:320px;scroll-snap-align:start; }
.bb-feat-arrow { position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;background:#fff;border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer;z-index:4;box-shadow:0 2px 8px rgba(0,0,0,.12);transition:background .2s; }
.bb-feat-arrow:hover { background:var(--black);color:#fff; }
.bb-feat-arrow.prev { left:-10px; }
.bb-feat-arrow.next { right:-10px; }
.bb-feat-dots { display:flex;justify-content:center;gap:6px;margin-top:14px; }
.bb-feat-dot { width:6px;height:6px;border-radius:50%;background:var(--border-light);transition:background .2s,transform .2s; }
.bb-feat-dot.active { background:var(--black);transform:scale(1.3); }
.bb-fc { position:relative;border-radius:var(--r-md);overflow:hidden;height:280px;border:1px solid var(--border);cursor:pointer; }
.bb-fc-bg { position:absolute;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;transition:transform .45s cubic-bezier(.22,1,.36,1); }
.bb-fc-bg img { width:100%;height:100%;object-fit:cover; }
.bb-fc:hover .bb-fc-bg { transform:scale(1.04); }
.bb-fc-scrim { position:absolute;inset:0;background:linear-gradient(to top,rgba(35,31,32,.85) 0%,rgba(35,31,32,.15) 60%,rgba(35,31,32,0) 100%);transition:background .35s; }
.bb-fc:hover .bb-fc-scrim { background:rgba(35,31,32,.82); }
.bb-fc-def { position:absolute;bottom:0;left:0;right:0;padding:20px 22px 22px;z-index:2;transition:opacity .28s,transform .35s cubic-bezier(.22,1,.36,1); }
.bb-fc:hover .bb-fc-def { opacity:0;transform:translateY(10px);pointer-events:none; }
.bb-fc-def-icon { width:40px;height:40px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px; }
.bb-fc-def-title { font-family:'Open Sans',sans-serif;font-size:17px;font-weight:600;color:#fff; }
.bb-fc-hov { position:absolute;inset:0;padding:26px 22px;z-index:3;display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(16px);transition:opacity .32s ease .05s,transform .38s cubic-bezier(.22,1,.36,1) .05s;pointer-events:none; }
.bb-fc:hover .bb-fc-hov { opacity:1;transform:translateY(0);pointer-events:auto; }
.bb-fc-hov-icon { width:40px;height:40px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:14px; }
.bb-fc-hov-title { font-family:'Open Sans',sans-serif;font-size:16px;font-weight:600;color:#fff;margin-bottom:10px; }
.bb-fc-hov-desc { font-size:13px;color:rgba(255,255,255,.72);line-height:1.65;margin-bottom:14px; }
.bb-fc-tags { display:flex;flex-wrap:wrap;gap:6px; }
.bb-tag { background:rgba(255,255,255,.12);color:rgba(255,255,255,.8);font-family:'Inter',sans-serif;font-size:10px;font-weight:600;letter-spacing:.06em;padding:3px 9px;border-radius:var(--pill);border:1px solid rgba(255,255,255,.2); }

/* S8 Offer Box */
.bb-offer-sec { padding:76px 40px;background:#fff; }
.bb-offer-box { max-width:1060px;margin:0 auto;background:#231F20;border-radius:var(--r-md);padding:60px 64px;position:relative;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.32);transition:box-shadow .3s; }
.bb-offer-box::before { content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#E7DCA7,#7B6830); }
.bb-offer-inner { display:grid;grid-template-columns:1fr 380px;gap:56px;align-items:center; }
.bb-offer-ey { font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:16px; }
.bb-offer-h { font-family:'Open Sans',sans-serif;font-size:40px;font-weight:600;color:#ffffff !important;letter-spacing:-.02em;line-height:1.18;margin-bottom:12px; }
.bb .bb-offer-h, .bb-offer-box h2 { color:#ffffff !important; }
.bb-offer-body { font-size:15px;color:rgba(255,255,255,.55);margin-bottom:36px; }
.bb-offer-strip { background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-md);padding:24px 32px;display:flex;align-items:center;gap:28px;margin-bottom:32px;flex-wrap:wrap; }
.bb-op-lbl { font-family:'Inter',sans-serif;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px;color:rgba(255,255,255,.38); }
.bb-op-was { font-family:'Open Sans',sans-serif;font-size:26px;font-weight:600;color:rgba(255,255,255,.22);text-decoration:line-through; }
.bb-op-now { font-family:'Open Sans',sans-serif;font-size:52px;font-weight:700;color:#fff;letter-spacing:-.03em;line-height:1; }
.bb-op-div { color:rgba(255,255,255,.18);font-size:22px; }
.bb-op-save { background:linear-gradient(90deg,#E7DCA7,#7B6830);color:#111;font-family:'Inter',sans-serif;font-size:12px;font-weight:700;padding:8px 16px;border-radius:var(--pill);white-space:nowrap; }
.bb-offer-ctas { display:flex;gap:12px;flex-wrap:wrap; }
.bb-offer-fine { margin-top:18px;font-family:'Inter',sans-serif;font-size:11px;color:rgba(255,255,255,.22); }
.bb-offer-box .btn-b { background:#fff;color:#111; } .bb-offer-box .btn-b:hover { background:#e8e8e8; }
.bb-offer-box .btn-o { border-color:rgba(255,255,255,.28);color:rgba(255,255,255,.75); } .bb-offer-box .btn-o:hover { background:rgba(255,255,255,.12);color:#fff; }
.bb-offer-img-col { display:flex;align-items:center;justify-content:center; }
.bb-offer-img-placeholder { background:rgba(255,255,255,.05);border:1.5px dashed rgba(255,255,255,.2);border-radius:var(--r-md);height:280px;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:rgba(255,255,255,.3);font-size:12px;gap:8px;text-align:center; }

/* S9 Form */
.bb-form-sec { background:var(--bg);padding:76px 40px;overflow:visible; }
.bb-form-in { max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr 480px;gap:60px;align-items:start;overflow:visible; }
.bb-form-left { position:-webkit-sticky;position:sticky;top:32px;align-self:start;max-height:calc(100vh - 64px);overflow:visible; }
.bb-form-left h2 { font-size:32px;font-weight:600;letter-spacing:-.018em;margin-bottom:14px; }
.bb-form-left>p { font-size:14px;color:var(--text-2);margin-bottom:28px;line-height:1.7; }
.bb-form-right { min-height:0; }
.bb-req-list { list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:28px; }
.bb-req-list li { display:flex;gap:11px;align-items:flex-start;font-size:13px; }
.bb-chk-icon { width:20px;height:20px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px; }
.bb-cond-note { background:#fff;border:1px solid var(--border-light);border-left:3px solid var(--border);border-radius:0 var(--r-sm) var(--r-sm) 0;padding:16px 18px; }
.bb-cond-note strong { display:block;font-family:'Open Sans',sans-serif;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px; }
.bb-cond-note p { font-size:12px;color:var(--text-2);margin:0;line-height:1.6; }
.bb-form-card { background:#fff;border:1px solid var(--border);border-radius:var(--r-md);padding:36px 32px;box-shadow:0 1px 4px rgba(0,0,0,.08); }
.bb-form-title { font-family:'Open Sans',sans-serif;font-size:20px;font-weight:600;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border-light); }
.bb-fg { margin-bottom:16px; }
.bb-lbl { display:block;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2);margin-bottom:6px; }
.bb-req-star { color:var(--red);margin-left:2px; }
.bb-input { width:100%;background:var(--bg);border:1px solid var(--border-light);border-radius:var(--r-sm);padding:11px 14px;font-family:'Inter',sans-serif;font-size:13px;color:var(--text);transition:border-color .2s,background .2s,box-shadow .2s;appearance:none;outline:none; }
.bb-input:focus { border-color:var(--border);background:#fff;box-shadow:0 0 0 3px rgba(35,31,32,.07); }
.bb-sel-wrap { position:relative; } .bb-sel-wrap::after { content:'▾';position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:12px;pointer-events:none; }
.bb-upload { background:var(--bg);border:2px dashed var(--border-light);border-radius:var(--r-sm);padding:22px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s; }
.bb-upload:hover { border-color:var(--border);background:#ececec; }
.bb-submit { width:100%;margin-top:20px;padding:15px;font-size:14px;justify-content:center; }
.bb-form-fine { font-family:'Inter',sans-serif;font-size:11px;color:var(--muted);text-align:center;margin-top:10px; }

/* S10 Reviews */
.bb-reviews { padding:76px 40px;background:#fff; }
.bb-reviews-in { max-width:1120px;margin:0 auto; }
.bb-rev-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px; }
.bb-rev-card { background:var(--bg);border:1px solid var(--border-light);border-radius:var(--r-md);padding:26px 22px;transition:box-shadow .25s,transform .25s; }
.bb-rev-card:hover { box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-3px); }
.bb-stars { color:#B8945A;font-size:13px;letter-spacing:3px;margin-bottom:12px; }
.bb-rev-text { font-size:13px;font-style:italic;color:var(--text);line-height:1.72;margin-bottom:16px; }
.bb-rev-row { display:flex;align-items:center;gap:10px; }
.bb-av { width:32px;height:32px;background:var(--border-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Open Sans',sans-serif;font-size:12px;font-weight:600;color:var(--text-2);flex-shrink:0; }
.bb-rev-name { font-family:'Open Sans',sans-serif;font-size:12px;font-weight:600;color:var(--text); }
.bb-rev-tag { font-size:11px;color:var(--muted); }

/* S10b Stats */
.bb-stats { padding:44px 40px; }
.bb-stats-in { max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr); }
.bb-stat { text-align:center;padding:0 20px;border-right:1px solid rgba(255,255,255,.1); }
.bb-stat:last-child { border-right:none; }
.bb-stat-num { font-family:'Open Sans',sans-serif;font-size:38px;font-weight:700;color:#fff;letter-spacing:-.02em;display:block;line-height:1;margin-bottom:6px; }
.bb-stat-lbl { font-family:'Inter',sans-serif;font-size:11px;font-weight:500;color:rgba(255,255,255,.45);letter-spacing:.06em;text-transform:uppercase; }

/* S11 FAQ */
.bb-faq { padding:76px 40px;background:var(--bg); }
.bb-faq-in { max-width:720px;margin:0 auto; }
.bb-faq-item { background:#fff;border:1px solid var(--border-light);border-radius:var(--r-sm);margin-bottom:8px;overflow:hidden;transition:box-shadow .2s; }
.bb-faq-item:hover { box-shadow:0 1px 4px rgba(0,0,0,.08); }
.bb-faq-item.open { border-color:var(--border); }
.bb-faq-q { width:100%;display:flex;justify-content:space-between;align-items:center;padding:18px 20px;font-family:'Open Sans',sans-serif;font-size:14px;font-weight:600;color:var(--text);cursor:pointer;background:none;border:none;text-align:left;transition:background .15s; }
.bb-faq-q:hover { background:var(--bg); }
.bb-faq-tog { width:26px;height:26px;background:var(--bg);border:1px solid var(--border-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--text-2);flex-shrink:0;transition:background .2s,color .2s,transform .2s; }
.bb-faq-item.open .bb-faq-tog { background:var(--black);color:#fff;border-color:var(--black);transform:rotate(45deg); }
.bb-faq-a { font-family:'Inter',sans-serif;font-size:13px;color:var(--text-2);line-height:1.72;padding:0 20px;max-height:0;overflow:hidden;transition:max-height .32s cubic-bezier(.22,1,.36,1),padding .22s; }
.bb-faq-item.open .bb-faq-a { max-height:300px;padding:0 20px 18px; }

/* S12 Final CTA */
.bb-final { padding:96px 40px;background:#fff;text-align:center;border-top:1px solid var(--border-light); }
.bb-final h2 { font-size:42px;font-weight:600;letter-spacing:-.022em;margin-bottom:14px; }
.bb-final>p { font-size:15px;color:var(--text-2);max-width:460px;margin:0 auto 36px; }
.bb-final-ctas { display:flex;gap:12px;justify-content:center;flex-wrap:wrap; }
.bb-final-note { margin-top:20px;font-size:11px;color:var(--muted); }

@media(max-width:960px){
