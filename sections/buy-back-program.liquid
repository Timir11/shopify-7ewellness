<script>
(function(){
  /* Scroll reveal */
  var obs=new IntersectionObserver(function(e){e.forEach(function(i){if(i.isIntersecting){i.target.classList.add('on');obs.unobserve(i.target);}});},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.bb .rv').forEach(function(el){obs.observe(el);});

  /* FAQ accordion */
  document.querySelectorAll('.bb-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.parentElement,wasOpen=item.classList.contains('open');
      document.querySelectorAll('.bb-faq-item').forEach(function(i){i.classList.remove('open');i.querySelector('.bb-faq-tog').textContent='+';});
      if(!wasOpen){item.classList.add('open');}
    });
  });

  /* Smooth scroll */
  document.querySelectorAll('a[href^="#bb-"]').forEach(function(a){
    a.addEventListener('click',function(e){var t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}});
  });

  /* Fix step numbers — only count step blocks */
  (function(){
    var stepEls = document.querySelectorAll('.bb-steps .bb-step');
    stepEls.forEach(function(s, i){
      var numEl = s.querySelector('.bb-step-num');
      if(numEl) numEl.textContent = i + 1;
    });
  })();

  /* Feature card mobile slider */
  (function(){
    var wrap = document.getElementById('bb-feat-slider-wrap');
    var slider = document.getElementById('bb-feat-slider');
    var dotsWrap = document.getElementById('bb-feat-dots');
    var prevBtn = document.getElementById('bb-feat-prev');
    var nextBtn = document.getElementById('bb-feat-next');
    if(!wrap || !slider) return;

    var cards = slider.querySelectorAll('.bb-fc');
    var count = cards.length;
    var current = 0;

    /* Build dots */
    for(var d=0;d<count;d++){
      var dot = document.createElement('div');
      dot.className = 'bb-feat-dot' + (d===0?' active':'');
      dotsWrap.appendChild(dot);
    }
    var dots = dotsWrap.querySelectorAll('.bb-feat-dot');

    function updateDots(idx){
      dots.forEach(function(d,i){ d.classList.toggle('active', i===idx); });
      current = idx;
    }

    function scrollTo(idx){
      if(idx < 0) idx = 0;
      if(idx >= count) idx = count-1;
      var card = cards[idx];
      slider.scrollTo({left: card.offsetLeft - 20, behavior:'smooth'});
      updateDots(idx);
    }

    prevBtn.addEventListener('click', function(){ scrollTo(current - 1); });
    nextBtn.addEventListener('click', function(){ scrollTo(current + 1); });

    /* Update dot on scroll */
    var scrollTimer;
    slider.addEventListener('scroll', function(){
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function(){
        var closest = 0, minDist = Infinity;
        cards.forEach(function(c, i){
          var dist = Math.abs(c.offsetLeft - slider.scrollLeft - 20);
          if(dist < minDist){ minDist = dist; closest = i; }
        });
        updateDots(closest);
      }, 80);
    });
  })();

})();
</script>

