<div class="collection-tabs-section real-customer">
  <h2 class="tab-title">{{ section.settings.section_heading }}</h2>
  <div class="tabs tabs-mobile-slider">
    {% for block in section.blocks %}
    {% if block.type == 'tab_title' %}
    <button class="tab-button tab-button-{{ section.id }}" data-tab="tab-{{ forloop.index }}">
      {{ block.settings.heading }}
    </button>
    {% endif %}
    {% endfor %}
  </div>
  <div class="tab-content">
    {% for block in section.blocks %}
    {% if block.type == 'tab_title' %}
    <div class="review_slider review_grid tab-products tab-products-{{ section.id }} tab-{{ forloop.index }}"
      data-tab="tab-{{ forloop.index }}" style="display: none;">
      {%- for i in (1..7) -%}
      {%- capture first_image -%}first_image{{i}}{%- endcapture -%}
      {%- capture second_image -%}second_image{{i}}{%- endcapture -%}
      {%- capture review_content -%}review_content{{i}}{%- endcapture -%}
      {%- capture review_image -%}review_image{{i}}{%- endcapture -%}
      {%- capture review_product -%}review_product{{i}}{%- endcapture -%}

      {% assign first_image = block.settings[first_image] %}
      {% assign second_image = block.settings[second_image] %}
      {% assign review_product = block.settings[review_product] %}
      {% if block.settings[review_content] != blank %}
      <div class="grid">
        <div class="grid__item medium-up--two-thirds">
          <div class="wrp_all_div">
            <div class="customer_review">
              {% if block.settings[review_image] %}
              <div class="review_image">
                <img src="{{ block.settings[review_image] | image_url }}" width="80" height="80">
              </div>
              {% endif %}
              <div class="review_content">
                {{ block.settings[review_content] }}
              </div>
            </div>
            {% if review_product != blank %}
            {%- assign product = all_products[review_product] -%}
            {% if product.available %}
            <div class="wrp_div_full">
              <img src="{{ product.featured_image | image_url }}" alt="{{ product.title }}" width="115" height="100">
              <div class="wrp_all_details">
                <a href="{{ product.url }}">
                  <h4>{{ product.title }}</h4>
                </a>
                {% assign current_variant = product.selected_or_first_available_variant %}
                {%- assign product_id = 'AddToCartForm-' | append: product.id -%}
                {%- form 'product',
                product,
                id: product_id,
                class: 'product-single__form small--text-center'
                -%}
                <input type="hidden" name="data-product-id" value="{{ product.id }}">
                <button {% if product.empty? %} type="button" {% else %} type="submit" {% endif %} name="add"
                  data-add-to-cart class="coll_product_cart btn add-to-cart 123" {% unless current_variant.available %}
                  disabled="disabled" {% endunless %}>
                  <span data-add-to-cart-text="" data-default-text="Shop Recommended Products">
                    Shop Recommended Products
                  </span>
                </button>
                <!--
                                <input type="hidden" value="{{ product.selected_or_first_available_variant.id }}" name="id">
                              -->
                <select name="id" id="ProductSelect-{{ product.id }}" class="product-single__variants no-js"
                  data-product-select>
                  {%- for variant in product.variants -%}
                  {%- if variant.available -%}
                  <option value="{{ variant.id }}" {%- if variant==product.selected_or_first_available_variant -%}
                    selected="selected" {%- endif -%}>
                    {{ variant.title }} - {{ variant.price | money_with_currency }}
                  </option>
                  {%- else -%}
                  <option disabled="disabled">
                    {{ variant.title }} - {{ 'products.product.sold_out' | t }}
                  </option>
                  {%- endif -%}
                  {%- endfor -%}
                </select>
                <input type="hidden" value="1" name="quantity">
                {%- unless product.empty? -%}
                <textarea class="hide" aria-hidden="true" aria-label="Product JSON"
                  data-variant-json>{{ product.variants | json }}</textarea>
                {%- if product.options.size > 1 -%}
                <textarea class="hide" aria-hidden="true" aria-label="Variant JSON"
                  data-current-variant-json>{{ current_variant | json }}</textarea>
                {%- endif -%}
                {%- endunless -%}
                {% endform %}
              </div>
            </div>
            {% endif %}
            {% endif %}
          </div>
        </div>
        {% if first_image != blank or second_image != blank %}
        <div class="grid__item medium-up--one-third">
          <image-compare class="comparison comparison-{{ section.id }} comparison--style-classic"
            data-section-id="{{ section.id }}">
            <div class="comparison__draggable" data-draggable style="width=150px;">
              <div class="comparison__image-wrapper" data-primary-image style="width=150px;">
                {%- render 'image-element', img: first_image, img_width: 2000, loading: true, classes: comparison__image -%}
              </div>
            </div>
            <div class="comparison__image-wrapper" data-secondary-image>
              {%- render 'image-element', img: second_image, img_width: 2000, loading: true, classes: comparison__image -%}
            </div>
            <button class="comparison__button" data-button>
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-left"
                viewBox="0 0 284.49 498.98">
                <title>icon-chevron-left</title>
                <path
                  d="M249.49 0a35 35 0 0 1 24.75 59.75L84.49 249.49l189.75 189.74a35.002 35.002 0 1 1-49.5 49.5L10.25 274.24a35 35 0 0 1 0-49.5L224.74 10.25A34.89 34.89 0 0 1 249.49 0Z" />
              </svg>
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-chevron-right"
                viewBox="0 0 284.49 498.98">
                <title>icon-chevron</title>
                <path
                  d="M35 498.98a35 35 0 0 1-24.75-59.75l189.74-189.74L10.25 59.75a35.002 35.002 0 0 1 49.5-49.5l214.49 214.49a35 35 0 0 1 0 49.5L59.75 488.73A34.89 34.89 0 0 1 35 498.98Z" />
              </svg>
            </button>
          </image-compare>
        </div>
        {% endif %}
      </div>
      {% endif %}
      {%- endfor -%}
    </div>
    {% endif %}
    {% endfor %}
  </div>
</div>
