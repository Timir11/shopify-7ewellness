<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.tab-button-{{ section.id }}');
    const tabContents = document.querySelectorAll('.tab-products-{{ section.id }}');

    // Function to initialize Slick slider
    function initializeSlickSlider() {
      $('.review_slider').not('.slick-initialized').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        dots: true,
        arrows: false,
        autoplay: true,
        autoplaySpeed: 5000,
        adaptiveHeight: false,
        infinite: true,
        focusOnSelect: true,
        draggable: true,
        centerMode: true,
        centerPadding: '10%',
        responsive: [{
          breakpoint: 1024,
          settings: {
            slidesToShow: 1,
            centerPadding: '5%'
          }
        },
        {
          breakpoint: 320,
          settings: {
            draggable: false,
            slidesToShow: 1,
            centerPadding: '0%'
          }
        }
        ]
      });

      $('.review_slider').on('afterChange', function (event, slick, currentSlide) {
        $('.slick-slide').removeClass('slick-active-center');
        $('.slick-current').addClass('slick-active-center');
      });

      if ($(window).width() < 769) {
        $('.tabs-mobile-slider').slick({
          slidesToShow: 1,
          slidesToScroll: 1,
          dots: false,
          arrows: false,
          infinite: true,
          swipeToSlide: true,
          centerMode: true,
          focusOnSelect: true,
        });
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Remove active class from all tabs
        tabs.forEach(t => t.classList.remove('active'));

        // Add active class to clicked tab
        tab.classList.add('active');

        // Hide all tab contents
        tabContents.forEach(content => content.style.display = 'none');

        // Get the target tab data
        const targetTab = tab.getAttribute('data-tab');

        // Find the matching collection content
        tabContents.forEach(content => {
          const contentTab = content.getAttribute('data-tab');

          // Match the tab data with content data-tab
          if (contentTab === targetTab) {
            content.style.display = 'block';
            // Destroy existing slider if any
            if ($(content).find('.review_slider').hasClass('slick-initialized')) {
              $(content).find('.review_slider').slick('unslick');
            }
            // Reinitialize slider
            setTimeout(() => {
              initializeSlickSlider();
            }, 500);
          }
        });
      });
    });

    // Initialize first tab and slider on page load
    if (tabs.length > 0) {
      tabs[0].classList.add('active');
      if (document.querySelector('.tab-products-{{ section.id }}.tab-1')) {
        document.querySelector('.tab-products-{{ section.id }}.tab-1').style.display = 'block';
        // Initialize slider on first tab
        setTimeout(() => {
          initializeSlickSlider();
        }, 500);
      }
    }
  });
</script>{%- comment -%}

