{%- liquid
  assign paginate_by = 24
  assign mobile_flush = false
  assign per_row_desktop = section.settings.per_row_desktop
  assign per_row_mobile = section.settings.per_row_mobile
  if per_row_mobile == '2-flush'
    assign mobile_flush = true
  endif

  case per_row_desktop
    when 2
      assign grid_large_width = 'medium-up--one-half'
    when 3
      assign grid_large_width = 'medium-up--one-third'
    when 4
      assign grid_large_width = 'medium-up--one-quarter'
  endcase

  assign grid_small_width = 'grid-product--padded'

  if per_row_mobile contains '2'
    assign per_row_mobile = 2
    assign grid_small_width = 'small--one-half'
    assign fallback = '50vw'
  endif
-%}

{%- capture grid_item_width -%}{{ grid_small_width }} {{ grid_large_width}}{%- endcapture -%}

{% paginate search.results by 12 %}

<div
  id="CollectionGrid"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
  data-product-sliders-mobile="{% if per_row_mobile == '1' %}true{% else %}false{% endif %}">

  <div class="page-width page-content page-content--flush-bottom">
    <header class="section-header">
      <h1 class="section-header__title">
        {{ 'general.search.title' | t }}
      </h1>
      <div class="section-header__description">
        {%- if search.performed -%}
          {%- if search.results_count == 0 -%}
            {{ 'general.search.no_results_html' | t: terms: search.terms }}
          {%- else -%}
            {{ 'general.search.result_count' | t: count: search.results_count }}
          {%- endif -%}
        {%- endif -%}

        {%- render 'predictive-search', context: 'search-page' -%}
      </div>
    </header>
  </div>

  {% comment %} {%- if section.settings.enable_sidebar -%}
    {% render 'collection-grid-filter-controls', section: section, collection: search %}
  {%- endif -%} {% endcomment %}

  {% comment %} Filter and Sort functionality for mobile devices {% endcomment %}
  <div class="mobile-controls medium-up--hide">
    <!-- Filter Button -->
    <button id="filterButton" class="filter-button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="13" viewBox="0 0 16 13" fill="none">
        <path d="M15.4004 2.6001L7.40039 2.6001" stroke="#231F20" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="1.6" cy="1.6" r="1.6" transform="matrix(-1 0 0 1 4.20117 1)" stroke="#231F20" stroke-width="1.2"/>
        <path d="M1 10.6001L9 10.6001" stroke="#231F20" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="13.8012" cy="10.6" r="1.6" stroke="#231F20" stroke-width="1.2"/>
      </svg>
      <span>Filter</span>
    </button>
  </div>

  <!-- Filter Drawer -->
  <div id="filterDrawer" class="filter-drawer hidden">
    <div class="filter-drawer__header">
      <button id="closeFilterDrawer" class="filter-drawer__close">×</button>
      <h3>Filters</h3>
    </div>
    <div class="filter-drawer__content">
      <div
        id="MobileCollectionFiltersSection"
        class="collection-filter__wrapper"
        data-section-id="{{ section.id }}"
        data-section-type="collection-filter">
        {%- render 'collection-filters', section: section, collection: search -%}
      </div>
    </div>
  </div>
  

  {%- if search.performed -%}
    {% comment %} <div id="CollectionAjaxContent" class="page-width">
      <div class="grid grid--uniform grid--scattered-large-{{ per_row_desktop }} grid--scattered-small-{{ per_row_mobile }}{% if mobile_flush %} small--grid--flush{% endif %}">
        {%- for item in search.results -%}

          {%- if item.object_type == 'product' -%}
            {%- render 'product-grid-item'
              product: item,
              grid_item_width: grid_item_width,
              sizeVariable: grid_large_width,
              fallback: fallback,
            -%}
          {%- else -%}
            <div class="grid__item grid-search {{ grid_item_width }}">
              <div class="grid-search__page">
                <a href="{{ item.url }}" class="grid-search__page-link">
                  <span class="grid-search__page-content">
                    <span class="h4">{{ item.title }}</span>
                    {%- if item.object_type == 'article' and item.image -%}
                      {%- render 'image-element',
                        img: item.image,
                        classes: 'grid-product__image',
                        alt: item.title,
                        widths: '180, 360, 540',
                        sizeVariable: grid_large_width,
                        fallback: fallback,
                      -%}
                    {%- endif -%}
                    <p>{{ item.content | strip_html | truncatewords: 60 }}</p>
                  </span>
                </a>
              </div>
            </div>
          {%- endif -%}

        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div> {% endcomment %}

    <div class="page-width">
      <div id="CollectionAjaxContent">
        <div class="grid collection_page_grid">
          <div class="grid__item medium-up--one-quarter small--whole coll_filter filter_grid small--hide">
            <div id="CollectionFiltersSection" class="collection-filter__wrapper" data-section-id="{{ section.id }}"
              data-section-type="collection-filter">
              {%- render 'collection-filters', section: section, collection: search -%}
            </div>
          </div>

          <div class="grid__item medium-up--three-quarters small--whole collection_grid">
            <div class="grid collection_page_grid grid--uniform grid--scattered-large-{{ per_row_desktop }} grid--scattered-small-{{ per_row_mobile }}{% if mobile_flush %} small--grid--flush{% endif %}">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {%- render 'product-grid-item'
                    product: item,
                    grid_item_width: grid_item_width,
                    sizeVariable: grid_large_width,
                    fallback: fallback,
                  -%}
                {%- else -%}
                  <div class="grid__item grid-search grid-product product_grid_item {{ grid_item_width }}">
                    <div class="grid-search__page">
                      <a href="{{ item.url }}" class="grid-search__page-link">
                        <span class="grid-search__page-content">
                          <span class="h4">{{ item.title }}</span>
                          {%- if item.object_type == 'article' and item.image -%}
                          {%- render 'image-element',
                            img: item.image,
                            classes: 'grid-product__image',
                            alt: item.title,
                            widths: '180, 360, 540',
                            sizeVariable: grid_large_width,
                            fallback: fallback,
                          -%}
                          {%- endif -%}
                          <p>{{ item.content | strip_html | truncatewords: 60 }}</p>
                        </span>
                      </a>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

  {%- endif -%}
</div>

{% endpaginate %}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header_filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar",
      "label": "t:sections.main-search.settings.enable_sidebar.label",
      "default": true,
      "info": "t:sections.main-search.settings.enable_sidebar.info"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "t:sections.main-search.settings.enable_color_swatches.label",
      "info": "t:sections.main-search.settings.enable_color_swatches.info"
    },
    {
      "type": "checkbox",
      "id": "enable_swatch_labels",
      "label": "t:common.enable_swatch_labels.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collection_sort_enable",
      "label": "t:sections.main-search.settings.collection_sort_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header_product_grid"
    },
    {
      "type": "range",
      "id": "per_row_desktop",
      "label": "t:sections.main-search.settings.per_row_desktop.label",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "per_row_mobile",
      "label": "t:sections.main-search.settings.per_row_mobile.label",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "t:sections.main-search.settings.per_row_mobile.options.2.label"
        },
        {
          "value": "2-flush",
          "label": "t:sections.main-search.settings.per_row_mobile.options.2-flush.label"
        }
      ]
    }
  ]
}

{% endschema %}
